{
  "name": "teseor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @teseor/preview run dev",
    "build": "pnpm -r run build",
    "build:css": "pnpm --filter @teseor/css run build",
    "build:wrappers": "pnpm --filter '@teseor/{react,vue,svelte,angular,webc}' run build",
    "build:preview": "pnpm --filter @teseor/preview run build",
    "build:docs": "echo 'build:docs: lands at v0.2 with the docs site' && exit 0",
    "preview": "pnpm --filter @teseor/preview run preview",
    "test": "pnpm -r --if-present run test",
    "test:unit": "pnpm -r --if-present run test:unit",
    "test:e2e": "playwright test",
    "test:visual": "echo 'test:visual: lands at v0.2' && exit 0",
    "test:a11y": "echo 'test:a11y: lands at v0.2' && exit 0",
    "lint": "pnpm lint:ts && pnpm lint:css && pnpm lint:spec && pnpm lint:naming",
    "lint:ts": "biome check .",
    "lint:css": "stylelint 'packages/**/*.css'",
    "lint:spec": "echo 'lint:spec: lands when specs/ has content' && exit 0",
    "lint:naming": "node scripts/check-logical-naming.js",
    "gen": "pnpm --filter @teseor/codegen run gen",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "migrate-specs": "node scripts/migrate-specs.ts",
    "verify:no-dev-leak": "node scripts/verify-no-dev-leak.js",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepare": "lefthook install"
  },
  "size-limit": [
    {
      "name": "@teseor/css (full bundle)",
      "path": "packages/css/dist/teseor.css",
      "limit": "8 kB"
    },
    {
      "name": "@teseor/css/tokens.css",
      "path": "packages/css/dist/tokens.css",
      "limit": "4 kB"
    },
    {
      "name": "@teseor/css/utilities.css",
      "path": "packages/css/dist/utilities.css",
      "limit": "2 kB"
    },
    {
      "name": "@teseor/css/tailwind.css",
      "path": "packages/css/dist/tailwind.css",
      "limit": "6 kB"
    },
    {
      "name": "@teseor/css/components/button.css",
      "path": "packages/css/dist/components/button.css",
      "limit": "4 kB"
    }
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.60.0",
    "@size-limit/file": "^12.1.0",
    "@types/node": "^24.12.4",
    "lefthook": "^2.1.8",
    "size-limit": "^12.1.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
