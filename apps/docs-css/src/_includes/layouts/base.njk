<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="view-transition" content="same-origin">
  <meta name="description" content="{{ doc.description if doc.description else 'CSS-first component library with design tokens, layout primitives, and UI components.' }}">
  <title>{{ title }} - {{ t('teseor_css', 'Teseor CSS') }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;700&family=Noto+Sans+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="{{ '/css/index.css' | url }}">
  <link rel="stylesheet" href="{{ '/styles.css' | url }}">
  <script src="{{ '/sidebar-scroll.js' | url }}" defer></script>
</head>
<body class="ui-root ui-app-shell">
  <aside class="ui-sidebar">
    <nav class="ui-sidebar-nav ui-transition-name-sidebar" aria-label="Main navigation">
      <div class="ui-sidebar-nav__header">
        <a href="{{ '/' | url }}">
          <strong class="ui-text-xl">{{ t('teseor_css', 'Teseor CSS') }}</strong>
        </a>
        <p class="ui-text-sm ui-text-muted">v{{ version }}</p>
      </div>

      <div class="ui-sidebar-nav__content">
        {% include "partials/nav.njk" %}
      </div>

      <div class="ui-sidebar-nav__footer">
        <div class="ui-column ui-column--xs">
          <select class="ui-select" id="brand-select" onchange="setBrand(this.value)" aria-label="{{ t('theme_preset', 'Theme preset') }}">
            <option value="">{{ t('default_theme', 'Default') }}</option>
            <option value="corporate">{{ t('corporate_theme', 'Corporate') }}</option>
            <option value="playful">{{ t('playful_theme', 'Playful') }}</option>
            <option value="minimal">{{ t('minimal_theme', 'Minimal') }}</option>
            <option value="terminal">{{ t('terminal_theme', 'Terminal') }}</option>
          </select>
          <select class="ui-select" id="density-select" onchange="setDensity(this.value)" aria-label="{{ t('density', 'Density') }}">
            <option value="compact">{{ t('compact', 'Compact') }}</option>
            <option value="" selected>{{ t('default_density', 'Default') }}</option>
            <option value="comfortable">{{ t('comfortable', 'Comfortable') }}</option>
          </select>
          <button class="ui-button ui-button--sm ui-button--block" onclick="toggleTheme()" id="theme-toggle" aria-pressed="false" data-label-dark="{{ t('dark_mode', 'Dark Mode') }}" data-label-light="{{ t('light_mode', 'Light Mode') }}">{{ t('dark_mode', 'Dark Mode') }}</button>
          <button class="ui-button ui-button--sm ui-button--secondary ui-button--block" onclick="toggleDebug(this, 'ui-debug-grid')" aria-pressed="false">{{ t('toggle_grid', 'Toggle Grid') }}</button>
          <button class="ui-button ui-button--sm ui-button--secondary ui-button--block" onclick="toggleDebug(this, 'ui-debug-grid-rows')" aria-pressed="false">{{ t('toggle_row_grid', 'Toggle Row Grid') }}</button>
          <button class="ui-button ui-button--sm ui-button--secondary ui-button--block" onclick="toggleDebug(this, 'ui-debug-baseline')" aria-pressed="false">{{ t('toggle_baseline', 'Toggle Baseline') }}</button>
          <button class="ui-button ui-button--sm ui-button--secondary ui-button--block" onclick="toggleDebug(this, 'ui-debug-outline')" aria-pressed="false">{{ t('toggle_outlines', 'Toggle Outlines') }}</button>
        </div>
      </div>
    </nav>
  </aside>

  <main class="ui-main">
    <div class="ui-container">
      {% block content %}{{ content | safe }}{% endblock %}
    </div>
  </main>

  <script src="{{ '/debug-grid.js' | url }}" defer></script>
  <script src="{{ '/tabs.js' | url }}" defer></script>
  <script src="{{ '/theme-playground.js' | url }}" defer></script>
  <script>
    const DEBUG_CLASSES = ['ui-debug-grid', 'ui-debug-grid-rows', 'ui-debug-baseline', 'ui-debug-outline'];
    const DEBUG_KEY = 'debug-classes';

    function getDebugState() {
      const saved = sessionStorage.getItem(DEBUG_KEY);
      return saved ? JSON.parse(saved) : [];
    }

    function saveDebugState() {
      const active = DEBUG_CLASSES.filter(c => document.body.classList.contains(c));
      sessionStorage.setItem(DEBUG_KEY, JSON.stringify(active));
    }

    function toggleDebug(btn, className) {
      const isActive = document.body.classList.toggle(className);
      btn.setAttribute('aria-pressed', String(isActive));
      saveDebugState();
    }

    // Restore debug state on load
    const activeDebug = getDebugState();
    for (const c of activeDebug) {
      document.body.classList.add(c);
    }

    // Sync button aria-pressed with restored state
    document.querySelectorAll('.ui-sidebar-nav__footer button[aria-pressed]').forEach(btn => {
      const match = btn.getAttribute('onclick')?.match(/toggleDebug\(this, '([^']+)'\)/);
      if (match && activeDebug.includes(match[1])) {
        btn.setAttribute('aria-pressed', 'true');
      }
    });

    function toggleTheme() {
      withTransition(() => {
        const html = document.documentElement;
        const btn = document.getElementById('theme-toggle');
        const isDark = html.getAttribute('data-theme') === 'dark';
        if (isDark) {
          html.removeAttribute('data-theme');
          btn.textContent = btn.dataset.labelDark;
          btn.setAttribute('aria-pressed', 'false');
          localStorage.removeItem('theme');
        } else {
          html.setAttribute('data-theme', 'dark');
          btn.textContent = btn.dataset.labelLight;
          btn.setAttribute('aria-pressed', 'true');
          localStorage.setItem('theme', 'dark');
        }
      });
    }

    if (localStorage.getItem('theme') === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
      const themeBtn = document.getElementById('theme-toggle');
      themeBtn.textContent = themeBtn.dataset.labelLight;
      themeBtn.setAttribute('aria-pressed', 'true');
    }

    function withTransition(fn) {
      document.body.classList.add('theme-transitioning');
      fn();
      setTimeout(() => document.body.classList.remove('theme-transitioning'), 300);
    }

    function setBrand(value) {
      withTransition(() => {
        const html = document.documentElement;
        if (value) {
          html.setAttribute('data-brand', value);
          localStorage.setItem('brand', value);
        } else {
          html.removeAttribute('data-brand');
          localStorage.removeItem('brand');
        }
      });
    }

    const savedBrand = localStorage.getItem('brand');
    if (savedBrand) {
      document.documentElement.setAttribute('data-brand', savedBrand);
      document.getElementById('brand-select').value = savedBrand;
    }

    function setDensity(value) {
      withTransition(() => {
        const html = document.documentElement;
        if (value) {
          html.setAttribute('data-density', value);
          localStorage.setItem('density', value);
        } else {
          html.removeAttribute('data-density');
          localStorage.removeItem('density');
        }
      });
    }

    const savedDensity = localStorage.getItem('density');
    if (savedDensity) {
      document.documentElement.setAttribute('data-density', savedDensity);
      document.getElementById('density-select').value = savedDensity;
    }
  </script>
</body>
</html>
