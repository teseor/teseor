{# Components (grouped, collapsible subgroups) #}
{% set components = docs | byType('component') %}
{% set nonTypography = componentGroups | rejectattr("id", "equalto", "typography") %}
{% if components.length > 0 %}
<div class="ui-sidebar-nav__group">
  <span class="ui-sidebar-nav__group-label">{{ t('components', 'Components') }}</span>
  <ul class="ui-sidebar-nav__group-items">
    {% for group in componentGroups %}
      {% if group.id != "typography" %}
      {% set groupDocs = components | byGroup(group.id) | sortByTitle %}
      {% if groupDocs.length > 0 %}
      <li>
        <details class="ui-sidebar-nav__subgroup" open>
          <summary class="ui-sidebar-nav__subgroup-label">{{ group.label }}</summary>
          <ul class="ui-sidebar-nav__group-items">
            {% for doc in groupDocs %}
            <li><a class="ui-sidebar-nav__item ui-sidebar-nav__item--nested{% if page.url == doc.permalink %} ui-sidebar-nav__item--active{% endif %}" href="{{ doc.permalink | url }}"{% if page.url == doc.permalink %} aria-current="page"{% endif %}><span class="ui-sidebar-nav__label">{{ doc.title }}</span></a></li>
            {% endfor %}
          </ul>
        </details>
      </li>
      {% endif %}
      {% endif %}
    {% endfor %}
  </ul>
</div>
{% endif %}

{# Typography (separate top-level section) #}
