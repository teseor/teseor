---
layout: layouts/base.njk
title: Home
permalink: /
---
<section class="ui-docs-section">
  <h2>{{ t('welcome', 'Welcome to Teseor CSS') }}</h2>
  <p>{{ t('welcome_description', 'A CSS-first component library with design tokens, layout primitives, and UI components.') }}</p>

  <div class="ui-column ui-column--lg ui-mt-4">
    {% set tokens = docs | byType('token') | sortByTitle %}
    {% if tokens.length > 0 %}
    <div>
      <h3>{{ t('tokens', 'Tokens') }} ({{ tokens.length }})</h3>
      <ul class="ui-column ui-column--xs">
        {% for doc in tokens %}
        <li><a href="{{ doc.permalink | url }}">{{ doc.title }}</a></li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% set primitives = docs | byType('primitive') | sortByTitle %}
    {% if primitives.length > 0 %}
    <div>
      <h3>{{ t('primitives', 'Primitives') }} ({{ primitives.length }})</h3>
      <ul class="ui-column ui-column--xs">
        {% for doc in primitives %}
        <li><a href="{{ doc.permalink | url }}">{{ doc.title }}</a></li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% set components = docs | byType('component') | sortByTitle %}
    {% if components.length > 0 %}
    <div>
      <h3>{{ t('components', 'Components') }} ({{ components.length }})</h3>
      <ul class="ui-column ui-column--xs">
        {% for doc in components %}
        <li><a href="{{ doc.permalink | url }}">{{ doc.title }}</a></li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}

    {% set utilities = docs | byType('utility') | sortByTitle %}
    {% if utilities.length > 0 %}
    <div>
      <h3>{{ t('utilities', 'Utilities') }} ({{ utilities.length }})</h3>
      <ul class="ui-column ui-column--xs">
        {% for doc in utilities %}
        <li><a href="{{ doc.permalink | url }}">{{ doc.title }}</a></li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </div>
</section>
