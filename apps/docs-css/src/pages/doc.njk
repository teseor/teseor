---
pagination:
  data: docs
  size: 1
  alias: doc
permalink: "{{ doc.permalink }}"
eleventyComputed:
  title: "{{ doc.title }}"
  api: "{{ doc.api }}"
---
{% extends "layouts/base.njk" %}

{% block content %}
<section id="{{ doc.id }}" class="ui-docs-section" data-type="{{ doc.type }}">
  <h2>{{ doc.title }}</h2>
  <p>{{ doc.description }}</p>

  {% for section in doc.sections %}
    {% set isFirstSection = loop.first %}
    {% if section.title %}
    <h3>{{ section.title }}</h3>
    {% endif %}

    {% if section.description %}
    <p>{{ section.description }}</p>
    {% endif %}

    {% for example in section.examples %}
      {% set previewHtml = example.previewHtml %}
      {% set codeSnippet = example.codeHtml %}

      {# First example of first section gets CSS props and customization tabs #}
      {% set showCssProps = loop.first and isFirstSection and doc.api %}
      {% set showCustomization = loop.first and isFirstSection and doc.customization %}

      <div class="ui-tabs ui-mb-2">
        <div class="ui-tabs__list">
          <button class="ui-tabs__tab ui-tabs__tab--active">{{ t('preview', 'Preview') }}</button>
          <button class="ui-tabs__tab">{% if showCssProps %}{{ t('css', 'CSS') }}{% else %}{{ t('html', 'HTML') }}{% endif %}</button>
          {% if showCustomization %}
          <button class="ui-tabs__tab">{{ t('customization', 'Customization') }}</button>
          {% endif %}
        </div>
        <div class="ui-tabs__panel ui-tabs__panel--active">
          {{ previewHtml | safe }}
        </div>
        <div class="ui-tabs__panel">
          {% if showCssProps %}
            {# CSS Props Table #}
            <h4>{{ t('base', 'Base') }}</h4>
            <table class="ui-table ui-table--compact">
              <thead><tr><th>{{ t('class', 'Class') }}</th><th>{{ t('description', 'Description') }}</th></tr></thead>
              <tbody><tr><td><code>.ui-{{ doc.api.name }}</code></td><td>{{ t('base_class', 'Base class') }}</td></tr></tbody>
            </table>
            {% if doc.api.modifiers %}
              {% for groupName, def in doc.api.modifiers %}
                {% set heading = groupName | capitalize %}
                {% if def.values %}
                <h4>{{ heading }}</h4>
                {% if def.usage %}<p>{{ def.usage }}</p>{% endif %}
                <table class="ui-table ui-table--compact">
                  <thead><tr><th>{{ t('class', 'Class') }}</th><th>{{ t('value', 'Value') }}</th></tr></thead>
                  <tbody>
                    {% for val in def.values %}
                    <tr><td><code>.ui-{{ doc.api.name }}--{{ val }}</code></td><td>{{ val }}</td></tr>
                    {% endfor %}
                  </tbody>
                </table>
                {% elif def.type == 'boolean' %}
                <h4>{{ heading }}</h4>
                {% if def.usage %}<p>{{ def.usage }}</p>{% endif %}
                <table class="ui-table ui-table--compact">
                  <thead><tr><th>{{ t('class', 'Class') }}</th><th>{{ t('description', 'Description') }}</th></tr></thead>
                  <tbody><tr><td><code>.ui-{{ doc.api.name }}--{{ groupName }}</code></td><td>{{ def.usage or groupName }}</td></tr></tbody>
                </table>
                {% endif %}
              {% endfor %}
            {% endif %}
          {% else %}
            <pre class="ui-code-block"><code>{{ codeSnippet | escape }}</code></pre>
          {% endif %}
        </div>
        {% if showCustomization %}
        <div class="ui-tabs__panel">
          <p>{{ t('customization_hint', 'Override these CSS custom properties to customize the component.') }}</p>
          <table class="ui-table">
            <thead>
              <tr><th>{{ t('token', 'Token') }}</th><th>{{ t('default', 'Default') }}</th><th>{{ t('description', 'Description') }}</th></tr>
            </thead>
            <tbody>
              {% for prop in doc.customization %}
              <tr>
                <td><code>{{ prop.token }}</code></td>
                <td><code>{{ prop.default }}</code></td>
                <td>{{ prop.description }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}
      </div>
    {% endfor %}
  {% endfor %}
</section>
{% endblock %}
