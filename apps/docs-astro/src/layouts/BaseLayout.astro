---
interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'CSS-first component library with design tokens, layout primitives, and UI components.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="view-transition" content="same-origin" />
  <meta name="description" content={description} />
  <title>{title} - Teseor CSS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;700&family=Noto+Sans+Mono:wght@400;500&display=swap" />
  <link rel="stylesheet" href="/styles/global.css" />
  <script is:inline>
    // Restore theme/brand/density before first paint
    (function () {
      const theme = localStorage.getItem('theme');
      if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');

      const brand = localStorage.getItem('brand');
      if (brand) document.documentElement.setAttribute('data-brand', brand);

      const density = localStorage.getItem('density');
      if (density) document.documentElement.setAttribute('data-density', density);
    })();
  </script>
</head>
<body class="ui-root ui-app-shell">
  <slot />

  <script is:inline>
    // Sidebar scroll preservation
    const SCROLL_KEY = 'sidebar-scroll';

    function restoreScroll() {
      const sidebar = document.querySelector('.ui-sidebar-nav__content');
      if (!sidebar) return;
      const saved = sessionStorage.getItem(SCROLL_KEY);
      if (saved) {
        sidebar.style.scrollBehavior = 'auto';
        sidebar.scrollTop = parseInt(saved, 10);
        sidebar.style.scrollBehavior = '';
      }
    }

    function setupSaveOnClick() {
      const sidebar = document.querySelector('.ui-sidebar-nav__content');
      if (!sidebar) return;
      sidebar.addEventListener('click', (e) => {
        if (e.target.closest('a')) {
          sessionStorage.setItem(SCROLL_KEY, sidebar.scrollTop);
        }
      });
    }

    if ('onpagereveal' in window) {
      window.addEventListener('pagereveal', restoreScroll);
    } else {
      document.addEventListener('DOMContentLoaded', restoreScroll);
    }
    document.addEventListener('DOMContentLoaded', setupSaveOnClick);

    // Debug toggle utilities
    const DEBUG_CLASSES = ['ui-debug-grid', 'ui-debug-grid-rows', 'ui-debug-baseline', 'ui-debug-outline'];
    const DEBUG_KEY = 'debug-classes';

    function getDebugState() {
      const saved = sessionStorage.getItem(DEBUG_KEY);
      return saved ? JSON.parse(saved) : [];
    }

    function saveDebugState() {
      const active = DEBUG_CLASSES.filter(c => document.body.classList.contains(c));
      sessionStorage.setItem(DEBUG_KEY, JSON.stringify(active));
    }

    function updateDebugLabel(btn, isActive) {
      const label = btn.dataset.label;
      if (label) btn.textContent = label + ': ' + (isActive ? 'On' : 'Off');
      btn.setAttribute('aria-pressed', String(isActive));
    }

    window.toggleDebug = function (btn, className) {
      const isActive = document.body.classList.toggle(className);
      updateDebugLabel(btn, isActive);
      saveDebugState();
    };

    // Restore debug state
    const activeDebug = getDebugState();
    for (const c of activeDebug) {
      document.body.classList.add(c);
    }
    document.querySelectorAll('.ui-sidebar-nav__footer button[data-label]').forEach(btn => {
      const match = btn.getAttribute('onclick')?.match(/toggleDebug\(this, '([^']+)'\)/);
      if (match) updateDebugLabel(btn, activeDebug.includes(match[1]));
    });

    // Theme transition helper
    function withTransition(fn) {
      document.body.classList.add('theme-transitioning');
      fn();
      setTimeout(() => document.body.classList.remove('theme-transitioning'), 300);
    }

    // Theme toggle
    window.toggleTheme = function () {
      withTransition(() => {
        const html = document.documentElement;
        const btn = document.getElementById('theme-toggle');
        const isDark = html.getAttribute('data-theme') === 'dark';
        if (isDark) {
          html.removeAttribute('data-theme');
          btn.textContent = btn.dataset.labelDark;
          btn.setAttribute('aria-pressed', 'false');
          localStorage.removeItem('theme');
        } else {
          html.setAttribute('data-theme', 'dark');
          btn.textContent = btn.dataset.labelLight;
          btn.setAttribute('aria-pressed', 'true');
          localStorage.setItem('theme', 'dark');
        }
      });
    };

    // Sync theme button label on load
    if (localStorage.getItem('theme') === 'dark') {
      const themeBtn = document.getElementById('theme-toggle');
      if (themeBtn) {
        themeBtn.textContent = themeBtn.dataset.labelLight;
        themeBtn.setAttribute('aria-pressed', 'true');
      }
    }

    // Brand switcher
    window.setBrand = function (value) {
      withTransition(() => {
        const html = document.documentElement;
        if (value) {
          html.setAttribute('data-brand', value);
          localStorage.setItem('brand', value);
        } else {
          html.removeAttribute('data-brand');
          localStorage.removeItem('brand');
        }
      });
    };

    const savedBrand = localStorage.getItem('brand');
    if (savedBrand) {
      const brandSelect = document.getElementById('brand-select');
      if (brandSelect) brandSelect.value = savedBrand;
    }

    // Density switcher
    window.setDensity = function (value) {
      withTransition(() => {
        const html = document.documentElement;
        if (value) {
          html.setAttribute('data-density', value);
          localStorage.setItem('density', value);
        } else {
          html.removeAttribute('data-density');
          localStorage.removeItem('density');
        }
      });
    };

    const savedDensity = localStorage.getItem('density');
    if (savedDensity) {
      const densitySelect = document.getElementById('density-select');
      if (densitySelect) densitySelect.value = savedDensity;
    }
  </script>
</body>
</html>
