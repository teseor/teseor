---
import { Textarea, Code, Codeblock } from "@teseor/react";
import Base from "../../layouts/Base.astro";
---

<Base title="Textarea — Teseor">
  <main class="t-stack" data-gap="6">
    <h1>Textarea</h1>
    <p>Multi-line text input. Styled `&lt;textarea&gt;` with token-driven defaults and outline / subtle / plain visual variants. Native attributes (`rows`, `cols`, `placeholder`, `value`, `defaultValue`, `maxLength`, etc.) pass through `ComponentProps&lt;"textarea"&gt;`. Form-association attributes (`name`, `form`, `required`, `readOnly`, `disabled`) come from the formControl shared contract.</p>
    <section class="t-stack" data-gap="3">
      <h2>Examples</h2>
      <div class="t-stack" data-gap="2">
        <h3>default</h3>
        <div class="t-cluster" data-gap="3">
          <Textarea placeholder="Your message" />
        </div>
        <Codeblock>&lt;Textarea placeholder="Your message" /&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>variant-outline</h3>
        <div class="t-cluster" data-gap="3">
          <Textarea variant="outline" placeholder="Comment" />
        </div>
        <Codeblock>&lt;Textarea variant="outline" placeholder="Comment" /&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>variant-subtle</h3>
        <div class="t-cluster" data-gap="3">
          <Textarea variant="subtle" placeholder="Comment" />
        </div>
        <Codeblock>&lt;Textarea variant="subtle" placeholder="Comment" /&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>variant-plain</h3>
        <div class="t-cluster" data-gap="3">
          <Textarea variant="plain" placeholder="Comment" />
        </div>
        <Codeblock>&lt;Textarea variant="plain" placeholder="Comment" /&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>size-sm</h3>
        <div class="t-cluster" data-gap="3">
          <Textarea size="sm" placeholder="Compact" />
        </div>
        <Codeblock>&lt;Textarea size="sm" placeholder="Compact" /&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>size-lg</h3>
        <div class="t-cluster" data-gap="3">
          <Textarea size="lg" placeholder="Emphatic" />
        </div>
        <Codeblock>&lt;Textarea size="lg" placeholder="Emphatic" /&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>rows-2</h3>
        <div class="t-cluster" data-gap="3">
          <Textarea rows={2} placeholder="Two rows" />
        </div>
        <Codeblock>&lt;Textarea rows=&lbrace;2&rbrace; placeholder="Two rows" /&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>rows-6</h3>
        <div class="t-cluster" data-gap="3">
          <Textarea rows={6} placeholder="Six rows" />
        </div>
        <Codeblock>&lt;Textarea rows=&lbrace;6&rbrace; placeholder="Six rows" /&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>resize-none</h3>
        <div class="t-cluster" data-gap="3">
          <Textarea resize="none" placeholder="Fixed height" />
        </div>
        <Codeblock>&lt;Textarea resize="none" placeholder="Fixed height" /&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>resize-both</h3>
        <div class="t-cluster" data-gap="3">
          <Textarea resize="both" placeholder="Resize both directions" />
        </div>
        <Codeblock>&lt;Textarea resize="both" placeholder="Resize both directions" /&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>invalid</h3>
        <div class="t-cluster" data-gap="3">
          <Textarea invalid placeholder="Required" />
        </div>
        <Codeblock>&lt;Textarea invalid placeholder="Required" /&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>disabled</h3>
        <div class="t-cluster" data-gap="3">
          <Textarea disabled placeholder="Disabled" />
        </div>
        <Codeblock>&lt;Textarea disabled placeholder="Disabled" /&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>form-control</h3>
        <div class="t-cluster" data-gap="3">
          <Textarea name="comment" form="contact" required readOnly placeholder="Form-control attributes pass-through" />
        </div>
        <Codeblock>&lt;Textarea name="comment" form="contact" required readOnly placeholder="Form-control attributes pass-through" /&gt;</Codeblock>
      </div>
    </section>
    <section class="t-stack" data-gap="3">
      <h2>Props</h2>
      <table>
        <thead><tr><th>Prop</th><th>Type</th><th>Responsive</th><th>Default</th><th>Description</th></tr></thead>
        <tbody>
        <tr><td><Code>variant</Code></td><td><Code>"outline" | "subtle" | "plain"</Code></td><td></td><td><Code>null</Code></td><td>Visual style. See the Variants section for per-value descriptions.</td></tr>
        <tr><td><Code>size</Code></td><td><Code>"sm" | "md" | "lg"</Code></td><td>✓</td><td><Code>null</Code></td><td>Size scale. See the Sizes section for per-value descriptions.</td></tr>
        <tr><td><Code>resize</Code></td><td><Code>string</Code></td><td></td><td><Code>null</Code></td><td>Maps to CSS `resize`. Absence-of-attr leaves the base CSS default (`vertical`). Set to `none` for a fixed-height field, `both` for free resizing.</td></tr>
        <tr><td><Code>invalid</Code></td><td><Code>boolean</Code></td><td></td><td><Code>null</Code></td><td>Marks the field as invalid for styling. Emits `data-invalid="true"` on the root. ARIA wiring (`aria-invalid`) is consumer-supplied or comes from the Field composite (tracked under #692).</td></tr>
        </tbody>
      </table>
    </section>
    <section class="t-stack" data-gap="3">
      <h2>Form-control attributes</h2>
      <table>
        <thead><tr><th>Attribute</th><th>Type</th><th>Description</th></tr></thead>
        <tbody>
        <tr><td><Code>name</Code></td><td><Code>string</Code></td><td>HTML form field name (submitted with the form).</td></tr>
        <tr><td><Code>form</Code></td><td><Code>string</Code></td><td>Associates the control with a form element by id.</td></tr>
        <tr><td><Code>required</Code></td><td><Code>boolean</Code></td><td>Marks the control as required for form submission.</td></tr>
        <tr><td><Code>readOnly</Code></td><td><Code>boolean</Code></td><td>Prevents editing while keeping the value submitted.</td></tr>
        <tr><td><Code>disabled</Code></td><td><Code>boolean</Code></td><td>Disables interaction and excludes the value from form submission.</td></tr>
        </tbody>
      </table>
    </section>
    <section class="t-stack" data-gap="3">
      <h2>Variants</h2>
      <table>
        <thead><tr><th>Name</th><th>Description</th></tr></thead>
        <tbody>
        <tr><td><Code>outline</Code></td><td>Bordered box on the surface; default textarea chrome.</td></tr>
        <tr><td><Code>subtle</Code></td><td>Soft-fill background, no border; for dense forms where the field chrome should recede.</td></tr>
        <tr><td><Code>plain</Code></td><td>Borderless; only the focus ring chromes the field.</td></tr>
        </tbody>
      </table>
    </section>
    <section class="t-stack" data-gap="3">
      <h2>Sizes</h2>
      <table>
        <thead><tr><th>Name</th><th>Description</th></tr></thead>
        <tbody>
        <tr><td><Code>sm</Code></td><td>Compact density; matches `Input size="sm"`.</td></tr>
        <tr><td><Code>md</Code></td><td>Default size.</td></tr>
        <tr><td><Code>lg</Code></td><td>Emphatic; for hero forms and mobile-first layouts.</td></tr>
        </tbody>
      </table>
    </section>
    <section class="t-stack" data-gap="3">
      <h2>States</h2>
      <table>
        <thead><tr><th>State</th><th>Description</th></tr></thead>
        <tbody>
        <tr><td><Code>hover</Code></td><td>Pointer is over the textarea.</td></tr>
        <tr><td><Code>focus</Code></td><td>Keyboard focus is on the textarea; the focus ring is visible.</td></tr>
        <tr><td><Code>disabled</Code></td><td>Interaction is suppressed; the disabled visual state is applied.</td></tr>
        <tr><td><Code>invalid</Code></td><td>The `invalid` prop is set; the field carries the error visual state.</td></tr>
        </tbody>
      </table>
    </section>
    <section class="t-stack" data-gap="3">
      <h2>Tokens</h2>
      <table>
        <thead><tr><th>Token</th><th>Fallback</th><th>Description</th></tr></thead>
        <tbody>
        <tr><td><Code>--t-textarea-bg</Code></td><td><Code>--t-surface</Code></td><td>Background color of the textarea box; the `subtle` variant overrides this.</td></tr>
        <tr><td><Code>--t-textarea-fg</Code></td><td><Code>--t-on-surface</Code></td><td>Foreground (text) color.</td></tr>
        <tr><td><Code>--t-textarea-placeholder-fg</Code></td><td><Code>--t-on-surface-muted</Code></td><td>Color of the placeholder text.</td></tr>
        <tr><td><Code>--t-textarea-border-color</Code></td><td><Code>--t-border</Code></td><td>Border color in the `outline` variant.</td></tr>
        <tr><td><Code>--t-textarea-border-color-invalid</Code></td><td><Code>--t-danger</Code></td><td>Border color when the field is invalid.</td></tr>
        <tr><td><Code>--t-textarea-radius</Code></td><td><Code>--t-radius-md</Code></td><td>Corner rounding.</td></tr>
        <tr><td><Code>--t-textarea-pad-x</Code></td><td><Code>--t-space-3</Code></td><td>Inline padding; the size variant overrides this.</td></tr>
        <tr><td><Code>--t-textarea-pad-y</Code></td><td><Code>--t-space-2</Code></td><td>Block padding.</td></tr>
        <tr><td><Code>--t-textarea-font</Code></td><td><Code>--t-font-sans</Code></td><td>Font stack.</td></tr>
        <tr><td><Code>--t-textarea-font-size</Code></td><td><Code>--t-text-sm</Code></td><td>Font size; the size variant overrides this.</td></tr>
        <tr><td><Code>--t-textarea-focus-ring</Code></td><td><Code>--t-focus-ring</Code></td><td>Color of the focus outline.</td></tr>
        </tbody>
      </table>
    </section>
    <section class="t-stack" data-gap="3">
      <h2>Forced colors</h2>
      <p>In Windows High Contrast mode, the component remaps these semantic tokens to CSS system colors. Custom-property inheritance carries the values to every reference in the subtree.</p>
      <table>
        <thead><tr><th>Token</th><th>Default</th><th>Forced-colors</th></tr></thead>
        <tbody>
        <tr><td><Code>--t-border</Code></td><td><Code>oklch(from oklch(from oklch(58% 0.2 268deg) 50% calc(c * 0.025) h) 92% c h)</Code></td><td><Code>ButtonBorder</Code></td></tr>
        <tr><td><Code>--t-danger</Code></td><td><Code>color-mix(
      in oklch,
      oklch(from oklch(58% 0.2 268deg) 48% c 25deg),
      oklch(from oklch(58% 0.2 268deg) 48% c h) calc(0 * 100%)
    )</Code></td><td><Code>ButtonText</Code></td></tr>
        <tr><td><Code>--t-focus-ring</Code></td><td><Code>oklch(from oklch(58% 0.2 268deg) 55% c h)</Code></td><td><Code>Highlight</Code></td></tr>
        <tr><td><Code>--t-on-surface</Code></td><td><Code>oklch(from oklch(from oklch(58% 0.2 268deg) 50% calc(c * 0.025) h) 18% c h)</Code></td><td><Code>CanvasText</Code></td></tr>
        <tr><td><Code>--t-on-surface-muted</Code></td><td><Code>oklch(from oklch(from oklch(58% 0.2 268deg) 50% calc(c * 0.025) h) 18% c h)</Code></td><td><Code>CanvasText</Code></td></tr>
        <tr><td><Code>--t-surface</Code></td><td><Code>oklch(from oklch(from oklch(58% 0.2 268deg) 50% calc(c * 0.025) h) 97% c h)</Code></td><td><Code>Canvas</Code></td></tr>
        <tr><td><Code>--t-surface-muted</Code></td><td><Code>oklch(from oklch(from oklch(58% 0.2 268deg) 50% calc(c * 0.025) h) 92% c h)</Code></td><td><Code>Canvas</Code></td></tr>
        </tbody>
      </table>
    </section>
    <section class="t-stack" data-gap="3">
      <h2>Bundle size</h2>
      <table>
        <thead><tr><th>Artifact</th><th>Raw</th><th>Gzip</th><th>Brotli</th></tr></thead>
        <tbody>
        <tr><td><a href="https://github.com/teseor/teseor/blob/main/packages/css/src/components/textarea/textarea.css"><Code>@teseor/css/components/textarea.css</Code></a></td><td>5.04 KB</td><td>1.17 KB</td><td>1.01 KB</td></tr>
        </tbody>
      </table>
    </section>
  </main>
</Base>
