---
import { Cluster, Code, Codeblock } from "@teseor/react";
import Base from "../../layouts/Base.astro";
---

<Base title="Cluster — Teseor">
  <main class="t-stack" data-gap="6">
    <h1>Cluster</h1>
    <p>A horizontal layout primitive. Wraps children on the inline axis with consistent spacing.</p>
    <section class="t-stack" data-gap="3">
      <h2>Examples</h2>
      <div class="t-stack" data-gap="2">
        <h3>gap-3</h3>
        <div class="t-cluster" data-gap="3">
          <Cluster gap="3">Cluster</Cluster>
        </div>
        <Codeblock>&lt;Cluster gap="3"&gt;Cluster&lt;/Cluster&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>gap-0</h3>
        <div class="t-cluster" data-gap="3">
          <Cluster gap="0">Cluster</Cluster>
        </div>
        <Codeblock>&lt;Cluster gap="0"&gt;Cluster&lt;/Cluster&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>justify-between</h3>
        <div class="t-cluster" data-gap="3">
          <Cluster gap="3" justify="between">Cluster</Cluster>
        </div>
        <Codeblock>&lt;Cluster gap="3" justify="between"&gt;Cluster&lt;/Cluster&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>justify-around</h3>
        <div class="t-cluster" data-gap="3">
          <Cluster gap="2" justify="around">Cluster</Cluster>
        </div>
        <Codeblock>&lt;Cluster gap="2" justify="around"&gt;Cluster&lt;/Cluster&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>align-center</h3>
        <div class="t-cluster" data-gap="3">
          <Cluster gap="3" align="center">Cluster</Cluster>
        </div>
        <Codeblock>&lt;Cluster gap="3" align="center"&gt;Cluster&lt;/Cluster&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>align-baseline</h3>
        <div class="t-cluster" data-gap="3">
          <Cluster gap="2" align="baseline">Cluster</Cluster>
        </div>
        <Codeblock>&lt;Cluster gap="2" align="baseline"&gt;Cluster&lt;/Cluster&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>responsive-gap</h3>
        <div class="t-cluster" data-gap="3">
          <Cluster gap={{ base: "2", md: "4" }}>Cluster</Cluster>
        </div>
        <Codeblock>&lt;Cluster gap=&lbrace;&lbrace; base: "2", md: "4" &rbrace;&rbrace;&gt;Cluster&lt;/Cluster&gt;</Codeblock>
      </div>
      <div class="t-stack" data-gap="2">
        <h3>responsive-justify</h3>
        <div class="t-cluster" data-gap="3">
          <Cluster gap="3" justify={{ base: "start", md: "between" }}>Cluster</Cluster>
        </div>
        <Codeblock>&lt;Cluster gap="3" justify=&lbrace;&lbrace; base: "start", md: "between" &rbrace;&rbrace;&gt;Cluster&lt;/Cluster&gt;</Codeblock>
      </div>
    </section>
    <section class="t-stack" data-gap="3">
      <h2>Props</h2>
      <table>
        <thead><tr><th>Prop</th><th>Type</th><th>Responsive</th><th>Default</th><th>Description</th></tr></thead>
        <tbody>
        <tr><td><Code>gap</Code></td><td><Code>string</Code></td><td>✓</td><td><Code>null</Code></td><td>Spacing between children. Accepts a token suffix from the `--t-space-*` scale (`0`–`8`).</td></tr>
        <tr><td><Code>align</Code></td><td><Code>string</Code></td><td>✓</td><td><Code>null</Code></td><td>Block-axis alignment of children.</td></tr>
        <tr><td><Code>justify</Code></td><td><Code>string</Code></td><td>✓</td><td><Code>null</Code></td><td>Inline-axis distribution of children.</td></tr>
        </tbody>
      </table>
    </section>
    <section class="t-stack" data-gap="3">
      <h2>Tokens</h2>
      <table>
        <thead><tr><th>Token</th><th>Fallback</th><th>Description</th></tr></thead>
        <tbody>
        <tr><td><Code>--t-cluster-gap</Code></td><td><Code>--t-space-3</Code></td><td>Default child spacing when `gap` is unset; overridable via `--t-cluster-gap`.</td></tr>
        <tr><td><Code>--t-cluster-align</Code></td><td><Code>stretch</Code></td><td>Default block-axis alignment when `align` is unset; overridable via `--t-cluster-align`.</td></tr>
        <tr><td><Code>--t-cluster-justify</Code></td><td><Code>flex-start</Code></td><td>Default inline-axis distribution when `justify` is unset; overridable via `--t-cluster-justify`.</td></tr>
        </tbody>
      </table>
    </section>
    <section class="t-stack" data-gap="3">
      <h2>Accessibility</h2>
      <p>Role: <Code>generic</Code></p>
    </section>
    <section class="t-stack" data-gap="3">
      <h2>Bundle size</h2>
      <table>
        <thead><tr><th>Artifact</th><th>Raw</th><th>Gzip</th><th>Brotli</th></tr></thead>
        <tbody>
        <tr><td><a href="https://github.com/teseor/teseor/blob/main/packages/css/src/components/cluster/cluster.css"><Code>@teseor/css/components/cluster.css</Code></a></td><td>9.04 KB</td><td>1.00 KB</td><td>0.76 KB</td></tr>
        </tbody>
      </table>
    </section>
  </main>
</Base>
