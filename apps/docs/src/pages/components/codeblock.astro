---
import { Codeblock } from "@teseor/react";
import Base from "../../layouts/Base.astro";
---

<Base title="Codeblock — Teseor">
  <main class="t-stack" data-gap="6">
    <h1>Codeblock</h1>
    <p>Block container for multi-line code with monospace font and horizontal overflow scroll.</p>
    <section class="t-stack" data-gap="3">
      <h2>Examples</h2>
      <div class="t-stack" data-gap="2">
        <h3>default</h3>
        <div class="t-cluster" data-gap="3">
          <Codeblock>Codeblock</Codeblock>
        </div>
        <Codeblock>&lt;Codeblock&gt;Codeblock&lt;/Codeblock&gt;</Codeblock>
      </div>
    </section>
    <section class="t-stack" data-gap="3">
      <h2>Tokens</h2>
      <table>
        <thead><tr><th>Token</th><th>Fallback</th><th>Description</th></tr></thead>
        <tbody>
        <tr><td><code>--t-codeblock-bg</code></td><td><code>--t-neutral-20</code></td><td>Background fill for the block.</td></tr>
        <tr><td><code>--t-codeblock-fg</code></td><td><code>--t-on-surface</code></td><td>Text color.</td></tr>
        <tr><td><code>--t-codeblock-pad</code></td><td><code>--t-space-3</code></td><td>Inner padding.</td></tr>
        <tr><td><code>--t-codeblock-radius</code></td><td><code>--t-radius-md</code></td><td>Corner radius.</td></tr>
        <tr><td><code>--t-codeblock-font</code></td><td><code>--t-font-mono</code></td><td>Monospace family.</td></tr>
        </tbody>
      </table>
    </section>
    <section class="t-stack" data-gap="3">
      <h2>Bundle size</h2>
      <table>
        <thead><tr><th>Artifact</th><th>Raw</th><th>Gzip</th><th>Brotli</th></tr></thead>
        <tbody>
        <tr><td><a href="https://github.com/teseor/teseor/blob/main/packages/css/src/components/codeblock/codeblock.css"><code>@teseor/css/components/codeblock.css</code></a></td><td>1.00 KB</td><td>0.46 KB</td><td>0.38 KB</td></tr>
        </tbody>
      </table>
    </section>
  </main>
</Base>
