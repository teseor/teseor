<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="view-transition" content="same-origin">
  <meta name="description" content="{{ doc.description if doc.description else 'CSS-first component library with design tokens, layout primitives, and UI components.' }}">
  <title>{{ title }} - Teseor CSS</title>
  <link rel="stylesheet" href="{{ '/css/index.css' | url }}">
  <link rel="stylesheet" href="{{ '/styles.css' | url }}">
  <script src="{{ '/sidebar-scroll.js' | url }}" defer></script>
</head>
<body class="ui-root ui-app-shell">
  <aside class="ui-sidebar">
    <nav class="ui-sidebar-nav ui-transition-name-sidebar" aria-label="Main navigation">
      <div class="ui-sidebar-nav__header">
        <a href="{{ '/' | url }}">
          <strong class="ui-text-xl">Teseor CSS</strong>
        </a>
        <p class="ui-text-sm ui-text-muted">v{{ version }}</p>
      </div>

      <div class="ui-sidebar-nav__content">
        {% include "partials/nav.njk" %}
      </div>

      <div class="ui-sidebar-nav__footer">
        <div class="ui-stack ui-stack--xs">
          <button class="ui-button ui-button--sm ui-button--block" onclick="toggleTheme()" id="theme-toggle" aria-pressed="false">Dark Mode</button>
          <button class="ui-button ui-button--sm ui-button--secondary ui-button--block" onclick="toggleDebug(this, 'ui-debug-grid')" aria-pressed="false">Toggle Grid</button>
          <button class="ui-button ui-button--sm ui-button--secondary ui-button--block" onclick="toggleDebug(this, 'ui-debug-grid-rows')" aria-pressed="false">Toggle Row Grid</button>
          <button class="ui-button ui-button--sm ui-button--secondary ui-button--block" onclick="toggleDebug(this, 'ui-debug-baseline')" aria-pressed="false">Toggle Baseline</button>
          <button class="ui-button ui-button--sm ui-button--secondary ui-button--block" onclick="toggleDebug(this, 'ui-debug-outline')" aria-pressed="false">Toggle Outlines</button>
        </div>
      </div>
    </nav>
  </aside>

  <main class="ui-main">
    <div class="ui-container">
      {% block content %}{{ content | safe }}{% endblock %}
    </div>
  </main>

  <script src="{{ '/debug-grid.js' | url }}" defer></script>
  <script src="{{ '/tabs.js' | url }}" defer></script>
  <script>
    const DEBUG_CLASSES = ['ui-debug-grid', 'ui-debug-grid-rows', 'ui-debug-baseline', 'ui-debug-outline'];
    const DEBUG_KEY = 'debug-classes';

    function getDebugState() {
      const saved = sessionStorage.getItem(DEBUG_KEY);
      return saved ? JSON.parse(saved) : [];
    }

    function saveDebugState() {
      const active = DEBUG_CLASSES.filter(c => document.body.classList.contains(c));
      sessionStorage.setItem(DEBUG_KEY, JSON.stringify(active));
    }

    function toggleDebug(btn, className) {
      const isActive = document.body.classList.toggle(className);
      btn.setAttribute('aria-pressed', String(isActive));
      saveDebugState();
    }

    // Restore debug state on load
    const activeDebug = getDebugState();
    for (const c of activeDebug) {
      document.body.classList.add(c);
    }

    // Sync button aria-pressed with restored state
    document.querySelectorAll('.ui-sidebar-nav__footer button[aria-pressed]').forEach(btn => {
      const match = btn.getAttribute('onclick')?.match(/toggleDebug\(this, '([^']+)'\)/);
      if (match && activeDebug.includes(match[1])) {
        btn.setAttribute('aria-pressed', 'true');
      }
    });

    function toggleTheme() {
      const html = document.documentElement;
      const btn = document.getElementById('theme-toggle');
      const isDark = html.getAttribute('data-theme') === 'dark';
      if (isDark) {
        html.removeAttribute('data-theme');
        btn.textContent = 'Dark Mode';
        btn.setAttribute('aria-pressed', 'false');
        localStorage.removeItem('theme');
      } else {
        html.setAttribute('data-theme', 'dark');
        btn.textContent = 'Light Mode';
        btn.setAttribute('aria-pressed', 'true');
        localStorage.setItem('theme', 'dark');
      }
    }

    if (localStorage.getItem('theme') === 'dark') {
      document.documentElement.setAttribute('data-theme', 'dark');
      const themeBtn = document.getElementById('theme-toggle');
      themeBtn.textContent = 'Light Mode';
      themeBtn.setAttribute('aria-pressed', 'true');
    }
  </script>
</body>
</html>
