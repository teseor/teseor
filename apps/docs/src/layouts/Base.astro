---
// dogfood-allow: temporary layout shell — Sidebar primitive lands in v0.3
import { ClientRouter } from "astro:transitions";
import "@teseor/css";
import { components } from "../lib/components.ts";

interface Props {
  title: string;
}

const { title } = Astro.props;

const navItems = [
  { href: "/", label: "Home" },
  ...components.map((c) => ({ href: c.href, label: c.label })),
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
    <style is:global>
      body {
        margin: 0;
        font-family: system-ui, -apple-system, sans-serif;
        color: var(--t-on-surface);
        background: var(--t-surface);
      }

      .layout {
        display: grid;
        grid-template-columns: 14rem 1fr;
        min-block-size: 100vh;
      }

      .sidenav {
        border-inline-end: 1px solid var(--t-neutral-30);
        padding: var(--t-space-5) var(--t-space-4);
        background: var(--t-neutral-10);
        position: sticky;
        inset-block-start: 0;
        block-size: 100vh;
      }

      .sidenav h2 {
        margin: 0 0 var(--t-space-3);
        font-size: 0.875rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--t-neutral-70);
      }

      .sidenav ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: var(--t-space-1);
      }

      .sidenav a {
        display: block;
        padding: var(--t-space-2) var(--t-space-3);
        border-radius: var(--t-radius-sm);
        color: inherit;
        text-decoration: none;
      }

      .sidenav a:hover {
        background: var(--t-neutral-20);
      }

      .sidenav a[aria-current="page"] {
        background: var(--t-neutral-90);
        color: var(--t-neutral-10);
      }

      .content {
        padding: var(--t-space-6) var(--t-space-7);
        max-inline-size: 60rem;
      }

      .content table {
        border-collapse: collapse;
        inline-size: 100%;
        font-size: 0.875rem;
      }

      .content thead {
        background: var(--t-neutral-10);
      }

      .content th,
      .content td {
        padding: var(--t-space-2) var(--t-space-3);
        border-block-end: 1px solid var(--t-neutral-30);
        text-align: start;
        vertical-align: top;
      }

      .content th {
        font-weight: 600;
        color: var(--t-neutral-70);
        text-transform: uppercase;
        font-size: 0.75rem;
        letter-spacing: 0.05em;
      }

      .content code {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.85em;
        background: var(--t-neutral-10);
        padding: 0.1em 0.35em;
        border-radius: var(--t-radius-sm);
      }

      .content .t-stack > code,
      .content pre > code {
        display: block;
        padding: var(--t-space-3) var(--t-space-4);
        background: var(--t-neutral-90);
        color: var(--t-neutral-10);
        border-radius: var(--t-radius-md);
        font-size: 0.875rem;
        line-height: 1.5;
        white-space: pre-wrap;
        overflow-x: auto;
      }

      .content pre {
        margin: 0;
      }

      .content h1 {
        margin-block-start: 0;
      }
    </style>
  </head>
  <body>
    <div class="layout">
      <aside class="sidenav" transition:persist="sidenav">
        <h2>Teseor</h2>
        <ul>
          {
            navItems.map((item) => {
              const target = item.href.replace(/\/$/, "") || "/";
              const isCurrent = target === currentPath;
              return (
                <li>
                  <a href={item.href} aria-current={isCurrent ? "page" : undefined}>
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </aside>
      <div class="content">
        <slot />
      </div>
    </div>
  </body>
</html>
