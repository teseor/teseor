{
  "name": "@teseor/css",
  "version": "3.0.0",
  "description": "Teseor design system — CSS source of truth",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "style": "./dist/teseor.css",
      "default": "./dist/teseor.css"
    },
    "./tokens.css": {
      "style": "./dist/tokens.css",
      "default": "./dist/tokens.css"
    },
    "./utilities.css": {
      "style": "./dist/utilities.css",
      "default": "./dist/utilities.css"
    },
    "./tailwind.css": {
      "style": "./dist/tailwind.css",
      "default": "./dist/tailwind.css"
    },
    "./*": {
      "style": "./dist/*",
      "default": "./dist/*"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.."
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teseor/teseor.git",
    "directory": "packages/css"
  },
  "devDependencies": {
    "postcss": "^8.5.15",
    "postcss-custom-media": "^12.0.1",
    "postcss-each": "^1.1.0",
    "postcss-import": "^16.1.1",
    "postcss-value-parser": "^4.2.0"
  }
}
