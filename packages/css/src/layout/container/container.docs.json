              "style": { "background": "var(--ui-color-bg-muted)" },
              "children": [{ "tag": "p", "text": "Centered container" }]
            }
          ],
          "code": "<div class=\"ui-container ui-container--center\">Centered container</div>"
        }
      ]
    },
    {
