{
  "id": "box",
  "type": "primitive",
  "title": "Box",
  "description": "Base container with style props. Foundation for layout primitives.",
  "api": "box.api.json",
  "sections": [
    {
      "title": "Default",
      "examples": [
        {
          "items": [{ "tag": "div", "class": "ui-box", "text": "Content" }],
          "code": "<div class=\"ui-box\">Content</div>"
        }
      ]
    },
    {
      "title": "Padding",
      "examples": [
        {
          "layout": "column",
          "items": [
            { "tag": "div", "class": "ui-box ui-box--p-1 ui-box--bg-subtle", "text": "Padding 1" },
            { "tag": "div", "class": "ui-box ui-box--p-2 ui-box--bg-subtle", "text": "Padding 2" },
            { "tag": "div", "class": "ui-box ui-box--p-3 ui-box--bg-subtle", "text": "Padding 3" },
            { "tag": "div", "class": "ui-box ui-box--p-4 ui-box--bg-subtle", "text": "Padding 4" }
          ],
          "code": "<div class=\"ui-box ui-box--p-1\">...</div>\n<div class=\"ui-box ui-box--p-2\">...</div>\n<div class=\"ui-box ui-box--p-3\">...</div>\n<div class=\"ui-box ui-box--p-4\">...</div>"
        }
      ]
    },
    {
      "title": "Background",
      "examples": [
        {
          "layout": "column",
          "items": [
            {
              "tag": "div",
              "class": "ui-box ui-box--p-2 ui-box--bg-subtle",
              "text": "Subtle background"
            },
            {
              "tag": "div",
              "class": "ui-box ui-box--p-2 ui-box--bg-muted",
              "text": "Muted background"
            }
          ],
          "code": "<div class=\"ui-box ui-box--bg-subtle\">...</div>\n<div class=\"ui-box ui-box--bg-muted\">...</div>"
        }
      ]
    },
    {
      "title": "Rounded",
      "examples": [
        {
          "layout": "row",
          "items": [
            {
              "tag": "div",
              "class": "ui-box ui-box--p-3 ui-box--bg-subtle ui-box--rounded",
              "text": "Rounded"
            },
            {
              "tag": "div",
              "class": "ui-box ui-box--p-3 ui-box--bg-subtle ui-box--rounded-lg",
              "text": "Rounded lg"
            }
          ],
          "code": "<div class=\"ui-box ui-box--rounded\">...</div>\n<div class=\"ui-box ui-box--rounded-lg\">...</div>"
        }
      ]
    },
    {
      "title": "Custom via CSS Variables",
      "examples": [
        {
          "items": [
            {
              "tag": "div",
              "class": "ui-box",
              "attrs": {
                "style": "--box-padding: var(--ui-space-3); --box-bg: var(--ui-color-primary); --box-color: white; --box-radius: var(--ui-radius-lg);"
              },
              "text": "Custom box"
            }
          ],
          "code": "<div class=\"ui-box\" style=\"--box-padding: ...; --box-bg: ...;\">...</div>"
        }
      ]
    }
  ]
}
