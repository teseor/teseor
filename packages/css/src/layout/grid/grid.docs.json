                },
                {
                  "tag": "div",
                  "text": "Span 3",
                  "style": {
                    "grid-column": "span 3",
                    "background": "var(--ui-color-bg-muted)",
                    "padding": "var(--ui-space-2)"
                  }
                },
                {
                  "tag": "div",
                  "text": "Span full",
                  "style": {
                    "grid-column": "1 / -1",
                    "background": "var(--ui-color-bg-muted)",
                    "padding": "var(--ui-space-2)"
                  }
                }
              ]
            }
          ],
          "code": "{% set spans = ['2', '3', '4', 'full'] %}<div class=\"ui-grid ui-grid--4\">\n{% for s in spans %}  <div class=\"ui-grid-col-span-{{ s }}\">Span {{ s }}</div>\n{% endfor %}</div>"
        }
      ]
    },
