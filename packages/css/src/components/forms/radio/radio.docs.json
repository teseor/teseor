{
  "id": "radio",
  "type": "component",
  "title": "Radio",
  "description": "Native radio button with custom styling. Use for mutually exclusive options within a group.",
  "api": "./radio.api.json",
  "sections": [
    {
      "title": "Default",
      "examples": [
        {
          "layout": "row",
          "items": [
            { "tag": "input", "class": "ui-radio", "attrs": { "type": "radio", "name": "demo1" } },
            {
              "tag": "input",
              "class": "ui-radio",
              "attrs": { "type": "radio", "name": "demo1", "checked": "" }
            }
          ],
          "code": "<input type=\"radio\" class=\"ui-radio\" name=\"group1\">\n<input type=\"radio\" class=\"ui-radio\" name=\"group1\" checked>"
        }
      ]
    },
    {
      "title": "Sizes",
      "examples": [
        {
          "layout": "row",
          "items": [
            {
              "tag": "input",
              "class": "ui-radio ui-radio--sm",
              "attrs": { "type": "radio", "name": "sizes", "checked": "" }
            },
            {
              "tag": "input",
              "class": "ui-radio",
              "attrs": { "type": "radio", "name": "sizes2", "checked": "" }
            },
            {
              "tag": "input",
              "class": "ui-radio ui-radio--lg",
              "attrs": { "type": "radio", "name": "sizes3", "checked": "" }
            }
          ],
          "code": "<input type=\"radio\" class=\"ui-radio ui-radio--sm\" checked>\n<input type=\"radio\" class=\"ui-radio\" checked>\n<input type=\"radio\" class=\"ui-radio ui-radio--lg\" checked>"
        }
      ]
    },
    {
      "title": "States",
      "examples": [
        {
          "layout": "row",
          "items": [
            {
              "tag": "input",
              "class": "ui-radio",
              "attrs": { "type": "radio", "name": "states1" }
            },
            {
              "tag": "input",
              "class": "ui-radio",
              "attrs": { "type": "radio", "name": "states2", "checked": "" }
            },
            {
              "tag": "input",
              "class": "ui-radio",
              "attrs": { "type": "radio", "name": "states3", "disabled": "" }
            },
            {
              "tag": "input",
              "class": "ui-radio",
              "attrs": { "type": "radio", "name": "states4", "checked": "", "disabled": "" }
            }
          ],
          "code": "<input type=\"radio\" class=\"ui-radio\">\n<input type=\"radio\" class=\"ui-radio\" checked>\n<input type=\"radio\" class=\"ui-radio\" disabled>\n<input type=\"radio\" class=\"ui-radio\" checked disabled>"
        }
      ]
    },
    {
      "title": "Validation States",
      "examples": [
        {
          "layout": "row",
          "items": [
            {
              "tag": "input",
              "class": "ui-radio ui-radio--error",
              "attrs": { "type": "radio", "name": "error1" }
            },
            {
              "tag": "input",
              "class": "ui-radio ui-radio--error",
              "attrs": { "type": "radio", "name": "error2", "checked": "" }
            },
            {
              "tag": "input",
              "class": "ui-radio ui-radio--success",
              "attrs": { "type": "radio", "name": "success1" }
            },
            {
              "tag": "input",
              "class": "ui-radio ui-radio--success",
              "attrs": { "type": "radio", "name": "success2", "checked": "" }
            }
          ],
          "code": "<input type=\"radio\" class=\"ui-radio ui-radio--error\">\n<input type=\"radio\" class=\"ui-radio ui-radio--error\" checked>\n<input type=\"radio\" class=\"ui-radio ui-radio--success\">\n<input type=\"radio\" class=\"ui-radio ui-radio--success\" checked>"
        }
      ]
    },
    {
      "title": "With Label",
      "examples": [
        {
          "items": [
            {
              "tag": "label",
              "class": "ui-row",
              "attrs": { "style": "gap: var(--ui-space-1); cursor: pointer;" },
              "children": [
                {
                  "tag": "input",
                  "class": "ui-radio",
                  "attrs": { "type": "radio", "name": "labeled" }
                },
                { "tag": "span", "text": "Option one" }
              ]
            }
          ],
          "code": "<label class=\"ui-row\">\n  <input type=\"radio\" class=\"ui-radio\" name=\"group\">\n  <span>Option one</span>\n</label>"
        }
      ]
    },
    {
      "title": "Radio Group",
      "examples": [
        {
          "items": [
            {
              "tag": "fieldset",
              "attrs": { "style": "border: none; padding: 0; margin: 0;" },
              "children": [
                {
                  "tag": "legend",
                  "attrs": { "style": "font-weight: 600; margin-block-end: var(--ui-space-1);" },
                  "text": "Choose an option"
                },
                {
                  "tag": "div",
                  "class": "ui-column",
                  "attrs": { "style": "--column-gap: var(--ui-space-1);" },
                  "children": [
                    {
                      "tag": "label",
                      "class": "ui-row",
                      "attrs": { "style": "gap: var(--ui-space-1); cursor: pointer;" },
                      "children": [
                        {
                          "tag": "input",
                          "class": "ui-radio",
                          "attrs": { "type": "radio", "name": "group-demo", "checked": "" }
                        },
                        { "tag": "span", "text": "Option A" }
                      ]
                    },
                    {
                      "tag": "label",
                      "class": "ui-row",
                      "attrs": { "style": "gap: var(--ui-space-1); cursor: pointer;" },
                      "children": [
                        {
                          "tag": "input",
                          "class": "ui-radio",
                          "attrs": { "type": "radio", "name": "group-demo" }
                        },
                        { "tag": "span", "text": "Option B" }
                      ]
                    },
                    {
                      "tag": "label",
                      "class": "ui-row",
                      "attrs": { "style": "gap: var(--ui-space-1); cursor: pointer;" },
                      "children": [
                        {
                          "tag": "input",
                          "class": "ui-radio",
                          "attrs": { "type": "radio", "name": "group-demo" }
                        },
                        { "tag": "span", "text": "Option C" }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "code": "<fieldset>\n  <legend>Choose an option</legend>\n  <div class=\"ui-column\">\n    <label class=\"ui-row\">\n      <input type=\"radio\" class=\"ui-radio\" name=\"group\" checked>\n      <span>Option A</span>\n    </label>\n    <label class=\"ui-row\">\n      <input type=\"radio\" class=\"ui-radio\" name=\"group\">\n      <span>Option B</span>\n    </label>\n  </div>\n</fieldset>"
        }
      ]
    }
  ],
  "customization": [
    {
      "token": "--ui-radio-size",
      "default": "calc(var(--ui-unit) * 2)",
      "description": "Default size"
    },
    {
      "token": "--ui-radio-size-lg",
      "default": "calc(var(--ui-unit) * 3)",
      "description": "Large size"
    },
    {
      "token": "--ui-radio-bg",
      "default": "var(--ui-color-bg)",
      "description": "Background (unchecked)"
    },
    {
      "token": "--ui-radio-bg-checked",
      "default": "var(--ui-color-primary)",
      "description": "Background (checked)"
    },
    {
      "token": "--ui-radio-border-color",
      "default": "var(--ui-color-border-strong)",
      "description": "Border color"
    },
    {
      "token": "--ui-radio-border-color-focus",
      "default": "var(--ui-color-primary)",
      "description": "Focus border color"
    },
    {
      "token": "--ui-radio-dot-color",
      "default": "var(--ui-color-text-inverse)",
      "description": "Inner dot color"
    }
  ]
}
