    {
      "title": "Error State",
      "examples": [
        {
          "items": [
            {
              "tag": "fieldset",
              "class": "ui-checkbox-group ui-checkbox-group--error",
              "children": [
                {
                  "tag": "legend",
                  "class": "ui-checkbox-group__legend",
                  "text": "Terms"
