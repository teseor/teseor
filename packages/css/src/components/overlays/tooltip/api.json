{
  "$schema": "Auto-generated from index.scss annotations. Do not edit manually — run: pnpm generate:api",
  "name": "tooltip",
  "element": "div",
  "modifiers": {
    "position": {
      "values": ["top", "bottom", "start", "end", "hidden"]
    },
    "visible": {
      "type": "boolean"
    },
    "animate": {
      "type": "boolean"
    },
    "anchored": {
      "type": "boolean"
    }
  },
  "cssVars": [
    {
      "name": "--ui-tooltip-transition-duration",
      "default": "var(--ui-duration-fast)",
      "defaultValue": "100ms",
      "description": "Transition duration"
    },
    {
      "name": "--ui-tooltip-transition-timing",
      "default": "var(--ui-ease-default)",
      "description": "Transition timing function"
    },
    {
      "name": "--ui-tooltip-max-width",
      "default": "calc(var(--ui-unit) * 25)",
      "defaultValue": "200px",
      "description": "Max width"
    },
    {
      "name": "--ui-tooltip-line-height",
      "default": "calc(var(--ui-unit) * 2)",
      "defaultValue": "16px",
      "description": "Line height"
    },
    {
      "name": "--ui-tooltip-bg",
      "default": "var(--ui-color-text)",
      "description": "Background color"
    },
    {
      "name": "--ui-tooltip-color",
      "default": "var(--ui-color-bg)",
      "description": "Text color"
    },
    {
      "name": "--ui-tooltip-radius",
      "default": "var(--ui-radius-sm)",
      "defaultValue": "4px",
      "description": "Corner radius"
    },
    {
      "name": "--ui-tooltip-padding-x",
      "default": "calc(var(--ui-unit) * 1)",
      "defaultValue": "8px",
      "description": "Horizontal padding"
    },
    {
      "name": "--ui-tooltip-padding-y",
      "default": "calc(var(--ui-unit) / 2)",
      "defaultValue": "4px",
      "description": "Vertical padding"
    },
    {
      "name": "--ui-tooltip-font-size",
      "default": "var(--ui-font-size-sm)",
      "defaultValue": "14px",
      "description": "Font size"
    },
    {
      "name": "--ui-tooltip-z",
      "default": "var(--ui-z-index-tooltip)",
      "defaultValue": "600",
      "description": "Z-index stacking order"
    },
    {
      "name": "--ui-tooltip-arrow-size",
      "default": "calc(var(--ui-unit) / 2)",
      "defaultValue": "4px",
      "description": "Arrow size"
    }
  ]
}
