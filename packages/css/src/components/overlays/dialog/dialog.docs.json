{
  "id": "dialog",
  "type": "component",
  "title": "Dialog",
  "description": "Structured modal with header, body, and footer sections. Use with modal component for positioning.",
  "api": "./dialog.api.json",
  "sections": [
    {
      "title": "Default",
      "examples": [
        {
          "items": [
            {
              "tag": "div",
              "attrs": {
                "style": "position: relative; height: 240px; background: var(--ui-color-bg-subtle);"
              },
              "children": [
                {
                  "tag": "div",
                  "class": "ui-modal ui-modal--visible",
                  "attrs": { "style": "position: absolute;" },
                  "children": [
                    {
                      "tag": "div",
                      "class": "ui-modal__content ui-dialog",
                      "attrs": { "style": "max-height: 200px;" },
                      "children": [
                        {
                          "tag": "header",
                          "class": "ui-dialog__header",
                          "children": [
                            { "tag": "h2", "class": "ui-dialog__title", "text": "Dialog Title" },
                            {
                              "tag": "button",
                              "class": "ui-button ui-button--ghost ui-button--sm ui-dialog__close",
                              "text": "X"
                            }
                          ]
                        },
                        {
                          "tag": "div",
                          "class": "ui-dialog__body",
                          "children": [{ "tag": "p", "text": "Dialog content goes here." }]
                        },
                        {
                          "tag": "footer",
                          "class": "ui-dialog__footer",
                          "children": [
                            {
                              "tag": "button",
                              "class": "ui-button ui-button--ghost",
                              "text": "Cancel"
                            },
                            { "tag": "button", "class": "ui-button", "text": "Confirm" }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "code": "<div class=\"ui-modal\">\n  <div class=\"ui-modal__content ui-dialog\">\n    <header class=\"ui-dialog__header\">\n      <h2 class=\"ui-dialog__title\">Dialog Title</h2>\n      <button class=\"ui-button ui-button--ghost ui-dialog__close\">X</button>\n    </header>\n    <div class=\"ui-dialog__body\">\n      <p>Dialog content goes here.</p>\n    </div>\n    <footer class=\"ui-dialog__footer\">\n      <button class=\"ui-button ui-button--ghost\">Cancel</button>\n      <button class=\"ui-button\">Confirm</button>\n    </footer>\n  </div>\n</div>"
        }
      ]
    },
    {
      "title": "Borderless",
      "examples": [
        {
          "items": [
            {
              "tag": "div",
              "attrs": {
                "style": "position: relative; height: 200px; background: var(--ui-color-bg-subtle);"
              },
              "children": [
                {
                  "tag": "div",
                  "class": "ui-modal ui-modal--visible",
                  "attrs": { "style": "position: absolute;" },
                  "children": [
                    {
                      "tag": "div",
                      "class": "ui-modal__content ui-dialog ui-dialog--borderless",
                      "attrs": { "style": "max-height: 180px;" },
                      "children": [
                        {
                          "tag": "header",
                          "class": "ui-dialog__header",
                          "children": [
                            { "tag": "h2", "class": "ui-dialog__title", "text": "Simple Dialog" }
                          ]
                        },
                        {
                          "tag": "div",
                          "class": "ui-dialog__body",
                          "children": [{ "tag": "p", "text": "Content without borders." }]
                        },
                        {
                          "tag": "footer",
                          "class": "ui-dialog__footer",
                          "children": [{ "tag": "button", "class": "ui-button", "text": "OK" }]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "code": "<div class=\"ui-modal\">\n  <div class=\"ui-modal__content ui-dialog ui-dialog--borderless\">\n    ...\n  </div>\n</div>"
        }
      ]
    },
    {
      "title": "Confirmation Dialog",
      "examples": [
        {
          "items": [
            {
              "tag": "div",
              "attrs": {
                "style": "position: relative; height: 200px; background: var(--ui-color-bg-subtle);"
              },
              "children": [
                {
                  "tag": "div",
                  "class": "ui-modal ui-modal--sm ui-modal--visible",
                  "attrs": { "style": "position: absolute;" },
                  "children": [
                    {
                      "tag": "div",
                      "class": "ui-modal__content ui-dialog",
                      "children": [
                        {
                          "tag": "header",
                          "class": "ui-dialog__header",
                          "children": [
                            { "tag": "h2", "class": "ui-dialog__title", "text": "Delete Item?" }
                          ]
                        },
                        {
                          "tag": "div",
                          "class": "ui-dialog__body",
                          "children": [{ "tag": "p", "text": "This action cannot be undone." }]
                        },
                        {
                          "tag": "footer",
                          "class": "ui-dialog__footer",
                          "children": [
                            {
                              "tag": "button",
                              "class": "ui-button ui-button--ghost",
                              "text": "Cancel"
                            },
                            {
                              "tag": "button",
                              "class": "ui-button ui-button--danger",
                              "text": "Delete"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "code": "<div class=\"ui-modal ui-modal--sm\">\n  <div class=\"ui-modal__content ui-dialog\">\n    <header class=\"ui-dialog__header\">\n      <h2 class=\"ui-dialog__title\">Delete Item?</h2>\n    </header>\n    <div class=\"ui-dialog__body\">\n      <p>This action cannot be undone.</p>\n    </div>\n    <footer class=\"ui-dialog__footer\">\n      <button class=\"ui-button ui-button--ghost\">Cancel</button>\n      <button class=\"ui-button ui-button--danger\">Delete</button>\n    </footer>\n  </div>\n</div>"
        }
      ]
    }
  ],
  "customization": [
    {
      "token": "--ui-dialog-header-padding",
      "default": "calc(var(--ui-unit) * 2) calc(var(--ui-unit) * 3)",
      "description": "Header padding"
    },
    {
      "token": "--ui-dialog-body-padding",
      "default": "calc(var(--ui-unit) * 3)",
      "description": "Body padding"
    },
    {
      "token": "--ui-dialog-footer-padding",
      "default": "calc(var(--ui-unit) * 2) calc(var(--ui-unit) * 3)",
      "description": "Footer padding"
    },
    {
      "token": "--ui-dialog-border-color",
      "default": "var(--ui-color-border)",
      "description": "Section border color"
    }
  ]
}
