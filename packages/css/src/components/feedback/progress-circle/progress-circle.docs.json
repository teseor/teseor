    {
      "title": "Indeterminate",
      "description": "For unknown progress duration",
      "examples": [
        {
          "items": [
            {
              "tag": "svg",
              "class": "ui-progress-circle ui-progress-circle--indeterminate",
              "attrs": {
                "xmlns": "http://www.w3.org/2000/svg",
                "viewBox": "0 0 100 100",
                "role": "progressbar",
                "aria-label": "Loading"
              },
              "children": [
                {
                  "tag": "circle",
                  "class": "ui-progress-circle__track",
                  "attrs": { "cx": "50", "cy": "50", "r": "45" }
                },
