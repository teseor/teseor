{
  "id": "skeleton",
  "type": "component",
  "title": "Skeleton",
  "description": "Loading placeholder with shimmer animation for content loading states.",
  "api": "./skeleton.api.json",
  "sections": [
    {
      "title": "Text Lines",
      "examples": [
        {
          "items": [
            {
              "tag": "div",
              "attrs": {
                "style": "display: flex; flex-direction: column; gap: var(--ui-space-1);"
              },
              "children": [
                { "tag": "div", "class": "ui-skeleton ui-skeleton--text" },
                {
                  "tag": "div",
                  "class": "ui-skeleton ui-skeleton--text",
                  "attrs": { "style": "width: 80%;" }
                },
                {
                  "tag": "div",
                  "class": "ui-skeleton ui-skeleton--text",
                  "attrs": { "style": "width: 60%;" }
                }
              ]
            }
          ],
          "code": "<div class=\"ui-skeleton ui-skeleton--text\"></div>\n<div class=\"ui-skeleton ui-skeleton--text\" style=\"width: 80%;\"></div>\n<div class=\"ui-skeleton ui-skeleton--text\" style=\"width: 60%;\"></div>"
        }
      ]
    },
    {
      "title": "Shapes",
      "examples": [
        {
          "items": [
            {
              "tag": "div",
              "attrs": {
                "style": "display: flex; gap: var(--ui-space-2); align-items: flex-start;"
              },
              "children": [
                { "tag": "div", "class": "ui-skeleton ui-skeleton--circle" },
                {
                  "tag": "div",
                  "attrs": {
                    "style": "flex: 1; display: flex; flex-direction: column; gap: var(--ui-space-1);"
                  },
                  "children": [
                    { "tag": "div", "class": "ui-skeleton ui-skeleton--heading" },
                    { "tag": "div", "class": "ui-skeleton ui-skeleton--text" }
                  ]
                }
              ]
            }
          ],
          "code": "<div class=\"ui-skeleton ui-skeleton--circle\"></div>\n<div class=\"ui-skeleton ui-skeleton--heading\"></div>\n<div class=\"ui-skeleton ui-skeleton--text\"></div>"
        }
      ]
    },
    {
      "title": "Card Skeleton",
      "examples": [
        {
          "items": [
            {
              "tag": "div",
              "class": "ui-card",
              "attrs": { "style": "width: 300px;" },
              "children": [
                { "tag": "div", "class": "ui-skeleton ui-skeleton--rect" },
                {
                  "tag": "div",
                  "attrs": {
                    "style": "padding: var(--ui-space-2); display: flex; flex-direction: column; gap: var(--ui-space-1);"
                  },
                  "children": [
                    { "tag": "div", "class": "ui-skeleton ui-skeleton--heading" },
                    { "tag": "div", "class": "ui-skeleton ui-skeleton--text" },
                    {
                      "tag": "div",
                      "class": "ui-skeleton ui-skeleton--text",
                      "attrs": { "style": "width: 70%;" }
                    }
                  ]
                }
              ]
            }
          ],
          "code": "<div class=\"ui-card\">\n  <div class=\"ui-skeleton ui-skeleton--rect\"></div>\n  <div class=\"ui-skeleton ui-skeleton--heading\"></div>\n  <div class=\"ui-skeleton ui-skeleton--text\"></div>\n</div>"
        }
      ]
    },
    {
      "title": "Pulse Animation",
      "examples": [
        {
          "items": [{ "tag": "div", "class": "ui-skeleton ui-skeleton--text ui-skeleton--pulse" }],
          "code": "<div class=\"ui-skeleton ui-skeleton--text ui-skeleton--pulse\"></div>"
        }
      ]
    }
  ],
  "customization": [
    {
      "token": "--ui-skeleton-bg",
      "default": "var(--ui-color-bg-subtle)",
      "description": "Background color"
    },
    {
      "token": "--ui-skeleton-shimmer",
      "default": "rgb(255 255 255 / 0.5)",
      "description": "Shimmer highlight color"
    },
    {
      "token": "--ui-skeleton-radius",
      "default": "var(--ui-radius-sm)",
      "description": "Border radius"
    }
  ]
}
