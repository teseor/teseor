{
  "id": "spinner",
  "type": "component",
  "title": "Spinner",
  "description": "Loading indicator with pure CSS animation. Inherits color from parent.",
  "api": "./spinner.api.json",
  "sections": [
    {
      "title": "Default",
      "examples": [
        {
          "layout": "row",
          "items": [{ "tag": "div", "class": "ui-spinner" }],
          "code": "<div class=\"ui-spinner\"></div>"
        }
      ]
    },
    {
      "title": "Sizes",
      "examples": [
        {
          "layout": "row",
          "items": [
            { "tag": "div", "class": "ui-spinner ui-spinner--xs" },
            { "tag": "div", "class": "ui-spinner ui-spinner--sm" },
            { "tag": "div", "class": "ui-spinner" },
            { "tag": "div", "class": "ui-spinner ui-spinner--lg" },
            { "tag": "div", "class": "ui-spinner ui-spinner--xl" }
          ],
          "code": "<div class=\"ui-spinner ui-spinner--xs\"></div>\n<div class=\"ui-spinner ui-spinner--sm\"></div>\n<div class=\"ui-spinner\"></div>\n<div class=\"ui-spinner ui-spinner--lg\"></div>\n<div class=\"ui-spinner ui-spinner--xl\"></div>"
        }
      ]
    },
    {
      "title": "Color Inheritance",
      "examples": [
        {
          "items": [
            {
              "tag": "div",
              "class": "ui-row",
              "attrs": { "style": "gap: var(--ui-space-2);" },
              "children": [
                {
                  "tag": "div",
                  "attrs": { "style": "color: var(--ui-color-primary);" },
                  "children": [{ "tag": "div", "class": "ui-spinner" }]
                },
                {
                  "tag": "div",
                  "attrs": { "style": "color: var(--ui-color-danger);" },
                  "children": [{ "tag": "div", "class": "ui-spinner" }]
                },
                {
                  "tag": "div",
                  "attrs": { "style": "color: var(--ui-color-success);" },
                  "children": [{ "tag": "div", "class": "ui-spinner" }]
                }
              ]
            }
          ],
          "code": "<div style=\"color: var(--ui-color-primary);\">\n  <div class=\"ui-spinner\"></div>\n</div>"
        }
      ]
    },
    {
      "title": "In Button",
      "examples": [
        {
          "items": [
            {
              "tag": "button",
              "class": "ui-button ui-button--primary",
              "attrs": { "disabled": true, "style": "opacity: 0.7;" },
              "children": [
                { "tag": "div", "class": "ui-spinner ui-spinner--xs" },
                { "tag": "span", "text": "Loading..." }
              ]
            }
          ],
          "code": "<button class=\"ui-button\" disabled>\n  <div class=\"ui-spinner ui-spinner--xs\"></div>\n  <span>Loading...</span>\n</button>"
        }
      ]
    }
  ],
  "customization": [
    {
      "token": "--ui-spinner-size",
      "default": "calc(var(--ui-unit) * 4)",
      "description": "Default size"
    },
    {
      "token": "--ui-spinner-size-xs",
      "default": "calc(var(--ui-unit) * 2)",
      "description": "Extra small size"
    },
    {
      "token": "--ui-spinner-size-sm",
      "default": "calc(var(--ui-unit) * 3)",
      "description": "Small size"
    },
    {
      "token": "--ui-spinner-size-lg",
      "default": "calc(var(--ui-unit) * 5)",
      "description": "Large size"
    },
    {
      "token": "--ui-spinner-size-xl",
      "default": "calc(var(--ui-unit) * 6)",
      "description": "Extra large size"
    },
    {
      "token": "--ui-spinner-border-width",
      "default": "var(--ui-border-width-md)",
      "description": "Border width"
    },
    { "token": "--ui-spinner-color", "default": "currentcolor", "description": "Spinner color" },
    { "token": "--ui-spinner-track-color", "default": "transparent", "description": "Track color" },
    { "token": "--ui-spinner-duration", "default": "750ms", "description": "Animation duration" }
  ]
}
