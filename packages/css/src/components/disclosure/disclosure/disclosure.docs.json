{
  "id": "disclosure",
  "type": "component",
  "title": "Disclosure",
  "description": "Expandable/collapsible content section. Uses native details/summary for accessibility without JS.",
  "api": "./disclosure.api.json",
  "sections": [
    {
      "title": "Default",
      "examples": [
        {
          "items": [
            {
              "tag": "details",
              "class": "ui-disclosure",
              "children": [
                {
                  "tag": "summary",
                  "class": "ui-disclosure__trigger",
                  "children": [
                    { "text": "Click to expand" },
                    { "tag": "span", "class": "ui-disclosure__icon", "text": "\u25BE" }
                  ]
                },
                {
                  "tag": "div",
                  "class": "ui-disclosure__content",
                  "children": [{ "tag": "p", "text": "Hidden content that expands when clicked." }]
                }
              ]
            }
          ],
          "code": "<details class=\"ui-disclosure\">\n  <summary class=\"ui-disclosure__trigger\">\n    Click to expand\n    <span class=\"ui-disclosure__icon\">&#9662;</span>\n  </summary>\n  <div class=\"ui-disclosure__content\">\n    <p>Hidden content that expands when clicked.</p>\n  </div>\n</details>"
        }
      ]
    },
    {
      "title": "Open by Default",
      "examples": [
        {
          "items": [
            {
              "tag": "details",
              "class": "ui-disclosure",
              "attrs": { "open": true },
              "children": [
                {
                  "tag": "summary",
                  "class": "ui-disclosure__trigger",
                  "children": [
                    { "text": "Already expanded" },
                    { "tag": "span", "class": "ui-disclosure__icon", "text": "\u25BE" }
                  ]
                },
                {
                  "tag": "div",
                  "class": "ui-disclosure__content",
                  "children": [{ "tag": "p", "text": "This content is visible by default." }]
                }
              ]
            }
          ],
          "code": "<details class=\"ui-disclosure\" open>\n  <summary class=\"ui-disclosure__trigger\">Already expanded</summary>\n  <div class=\"ui-disclosure__content\">...</div>\n</details>"
        }
      ]
    },
    {
      "title": "Borderless",
      "examples": [
        {
          "items": [
            {
              "tag": "details",
              "class": "ui-disclosure ui-disclosure--borderless",
              "children": [
                {
                  "tag": "summary",
                  "class": "ui-disclosure__trigger",
                  "children": [
                    { "text": "Borderless disclosure" },
                    { "tag": "span", "class": "ui-disclosure__icon", "text": "\u25BE" }
                  ]
                },
                {
                  "tag": "div",
                  "class": "ui-disclosure__content",
                  "children": [{ "tag": "p", "text": "No border around the disclosure." }]
                }
              ]
            }
          ],
          "code": "<details class=\"ui-disclosure ui-disclosure--borderless\">\n  ...\n</details>"
        }
      ]
    },
    {
      "title": "Animated",
      "examples": [
        {
          "items": [
            {
              "tag": "details",
              "class": "ui-disclosure ui-disclosure--animate",
              "children": [
                {
                  "tag": "summary",
                  "class": "ui-disclosure__trigger",
                  "children": [
                    { "text": "Animated expansion" },
                    { "tag": "span", "class": "ui-disclosure__icon", "text": "\u25BE" }
                  ]
                },
                {
                  "tag": "div",
                  "class": "ui-disclosure__content",
                  "children": [{ "tag": "p", "text": "Content animates in when opened." }]
                }
              ]
            }
          ],
          "code": "<details class=\"ui-disclosure ui-disclosure--animate\">\n  ...\n</details>"
        }
      ]
    }
  ],
  "customization": [
    {
      "token": "--ui-disclosure-border-color",
      "default": "var(--ui-color-border)",
      "description": "Border color"
    },
    { "token": "--ui-disclosure-border-width", "default": "1px", "description": "Border width" },
    {
      "token": "--ui-disclosure-radius",
      "default": "var(--ui-radius-md)",
      "description": "Border radius"
    },
    {
      "token": "--ui-disclosure-trigger-height",
      "default": "var(--ui-row-3)",
      "description": "Trigger button height"
    },
    {
      "token": "--ui-disclosure-padding-x",
      "default": "calc(var(--ui-unit) * 2)",
      "description": "Horizontal padding"
    },
    {
      "token": "--ui-disclosure-padding-y",
      "default": "calc(var(--ui-unit) * 2)",
      "description": "Content vertical padding"
    }
  ]
}
