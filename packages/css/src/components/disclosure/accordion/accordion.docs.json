{
  "id": "accordion",
  "type": "component",
  "title": "Accordion",
  "description": "Container for grouped expandable sections. Use with disclosure components.",
  "api": "./accordion.api.json",
  "sections": [
    {
      "title": "Default",
      "examples": [
        {
          "items": [
            {
              "tag": "div",
              "class": "ui-accordion",
              "children": [
                {
                  "tag": "details",
                  "class": "ui-disclosure",
                  "children": [
                    {
                      "tag": "summary",
                      "class": "ui-disclosure__trigger",
                      "children": [
                        { "text": "Section 1" },
                        { "tag": "span", "class": "ui-disclosure__icon", "text": "\u25BE" }
                      ]
                    },
                    {
                      "tag": "div",
                      "class": "ui-disclosure__content",
                      "children": [{ "tag": "p", "text": "Content for section 1" }]
                    }
                  ]
                },
                {
                  "tag": "details",
                  "class": "ui-disclosure",
                  "children": [
                    {
                      "tag": "summary",
                      "class": "ui-disclosure__trigger",
                      "children": [
                        { "text": "Section 2" },
                        { "tag": "span", "class": "ui-disclosure__icon", "text": "\u25BE" }
                      ]
                    },
                    {
                      "tag": "div",
                      "class": "ui-disclosure__content",
                      "children": [{ "tag": "p", "text": "Content for section 2" }]
                    }
                  ]
                },
                {
                  "tag": "details",
                  "class": "ui-disclosure",
                  "children": [
                    {
                      "tag": "summary",
                      "class": "ui-disclosure__trigger",
                      "children": [
                        { "text": "Section 3" },
                        { "tag": "span", "class": "ui-disclosure__icon", "text": "\u25BE" }
                      ]
                    },
                    {
                      "tag": "div",
                      "class": "ui-disclosure__content",
                      "children": [{ "tag": "p", "text": "Content for section 3" }]
                    }
                  ]
                }
              ]
            }
          ],
          "code": "<div class=\"ui-accordion\">\n  <details class=\"ui-disclosure\">\n    <summary class=\"ui-disclosure__trigger\">Section 1</summary>\n    <div class=\"ui-disclosure__content\">...</div>\n  </details>\n  <details class=\"ui-disclosure\">\n    <summary class=\"ui-disclosure__trigger\">Section 2</summary>\n    <div class=\"ui-disclosure__content\">...</div>\n  </details>\n</div>"
        }
      ]
    },
    {
      "title": "Separated",
      "description": "Gap between accordion items",
      "api": "./accordion.api.json",
      "examples": [
        {
          "items": [
            {
              "tag": "div",
              "class": "ui-accordion ui-accordion--separated",
              "children": [
                {
                  "tag": "details",
                  "class": "ui-disclosure",
                  "children": [
                    {
                      "tag": "summary",
                      "class": "ui-disclosure__trigger",
                      "children": [
                        { "text": "Section 1" },
                        { "tag": "span", "class": "ui-disclosure__icon", "text": "\u25BE" }
                      ]
                    },
                    {
                      "tag": "div",
                      "class": "ui-disclosure__content",
                      "children": [{ "tag": "p", "text": "Content for section 1" }]
                    }
                  ]
                },
                {
                  "tag": "details",
                  "class": "ui-disclosure",
                  "children": [
                    {
                      "tag": "summary",
                      "class": "ui-disclosure__trigger",
                      "children": [
                        { "text": "Section 2" },
                        { "tag": "span", "class": "ui-disclosure__icon", "text": "\u25BE" }
                      ]
                    },
                    {
                      "tag": "div",
                      "class": "ui-disclosure__content",
                      "children": [{ "tag": "p", "text": "Content for section 2" }]
                    }
                  ]
                }
              ]
            }
          ],
          "code": "<div class=\"ui-accordion ui-accordion--separated\">\n  ...\n</div>"
        }
      ]
    },
    {
      "title": "With One Open",
      "examples": [
        {
          "items": [
            {
              "tag": "div",
              "class": "ui-accordion",
              "children": [
                {
                  "tag": "details",
                  "class": "ui-disclosure",
                  "attrs": { "open": true },
                  "children": [
                    {
                      "tag": "summary",
                      "class": "ui-disclosure__trigger",
                      "children": [
                        { "text": "Open Section" },
                        { "tag": "span", "class": "ui-disclosure__icon", "text": "\u25BE" }
                      ]
                    },
                    {
                      "tag": "div",
                      "class": "ui-disclosure__content",
                      "children": [{ "tag": "p", "text": "This section starts open" }]
                    }
                  ]
                },
                {
                  "tag": "details",
                  "class": "ui-disclosure",
                  "children": [
                    {
                      "tag": "summary",
                      "class": "ui-disclosure__trigger",
                      "children": [
                        { "text": "Closed Section" },
                        { "tag": "span", "class": "ui-disclosure__icon", "text": "\u25BE" }
                      ]
                    },
                    {
                      "tag": "div",
                      "class": "ui-disclosure__content",
                      "children": [{ "tag": "p", "text": "Click to open" }]
                    }
                  ]
                }
              ]
            }
          ],
          "code": "<div class=\"ui-accordion\">\n  <details class=\"ui-disclosure\" open>\n    <summary class=\"ui-disclosure__trigger\">Open Section</summary>\n    <div class=\"ui-disclosure__content\">...</div>\n  </details>\n  <details class=\"ui-disclosure\">\n    ...\n  </details>\n</div>"
        }
      ]
    }
  ],
  "customization": [
    {
      "token": "--ui-accordion-border-color",
      "default": "var(--ui-color-border)",
      "description": "Border color"
    },
    { "token": "--ui-accordion-border-width", "default": "1px", "description": "Border width" },
    {
      "token": "--ui-accordion-radius",
      "default": "var(--ui-radius-md)",
      "description": "Border radius"
    }
  ]
}
