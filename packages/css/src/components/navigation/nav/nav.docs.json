{
  "id": "nav",
  "type": "component",
  "title": "Nav",
  "description": "Horizontal or vertical navigation links for primary and secondary navigation.",
  "api": "./nav.api.json",
  "sections": [
    {
      "title": "Basic",
      "description": "Underline-style navigation with active state indicator.",
      "examples": [
        {
          "items": [
            {
              "tag": "nav",
              "class": "ui-nav",
              "children": [
                {
                  "tag": "ul",
                  "class": "ui-nav__list",
                  "children": [
                    {
                      "tag": "li",
                      "children": [
                        {
                          "tag": "a",
                          "class": "ui-nav__item ui-nav__item--active",
                          "text": "Dashboard",
                          "attrs": { "href": "#" }
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "children": [
                        {
                          "tag": "a",
                          "class": "ui-nav__item",
                          "text": "Projects",
                          "attrs": { "href": "#" }
                        }
                      ]
                    },
