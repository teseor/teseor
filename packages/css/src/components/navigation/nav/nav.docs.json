                      "tag": "li",
                      "children": [
                        {
                          "tag": "a",
                          "class": "ui-nav__item",
                          "text": "Settings",
                          "attrs": { "href": "#" }
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "children": [
                        {
                          "tag": "a",
                          "class": "ui-nav__item ui-nav__item--disabled",
                          "text": "Disabled",
                          "attrs": { "href": "#" }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
