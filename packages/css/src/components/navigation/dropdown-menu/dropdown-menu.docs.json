{
  "id": "dropdown-menu",
  "type": "component",
  "title": "Dropdown Menu",
  "description": "Trigger button with floating menu panel. Reuses the menu component for consistent item styling.",
  "api": "./dropdown-menu.api.json",
  "sections": [
    {
      "title": "Default",
      "examples": [
        {
          "items": [
            {
              "tag": "div",
              "class": "ui-dropdown-menu ui-dropdown-menu--open",
              "children": [
                {
                  "tag": "button",
                  "class": "ui-dropdown-menu__trigger ui-button",
                  "attrs": { "type": "button" },
                  "children": [
                    { "tag": "span", "text": "Actions" },
                    { "tag": "span", "class": "ui-dropdown-menu__trigger-icon", "text": "\u25BE" }
                  ]
                },
                {
                  "tag": "div",
                  "class": "ui-dropdown-menu__panel",
                  "attrs": { "role": "menu" },
                  "children": [
                    {
                      "tag": "div",
                      "class": "ui-menu",
                      "children": [
                        {
                          "tag": "ul",
                          "class": "ui-menu__group",
                          "children": [
                            {
                              "tag": "li",
                              "children": [
                                {
                                  "tag": "button",
                                  "class": "ui-menu__item",
                                  "attrs": { "role": "menuitem" },
                                  "text": "Edit"
                                }
                              ]
                            },
                            {
                              "tag": "li",
                              "children": [
                                {
                                  "tag": "button",
                                  "class": "ui-menu__item",
                                  "attrs": { "role": "menuitem" },
                                  "text": "Duplicate"
                                }
                              ]
                            },
                            {
                              "tag": "li",
                              "children": [
                                {
                                  "tag": "button",
                                  "class": "ui-menu__item ui-menu__item--danger",
                                  "attrs": { "role": "menuitem" },
                                  "text": "Delete"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "code": "<div class=\"ui-dropdown-menu ui-dropdown-menu--open\">\n  <button class=\"ui-dropdown-menu__trigger ui-button\">Actions \u25BE</button>\n  <div class=\"ui-dropdown-menu__panel\" role=\"menu\">\n    <div class=\"ui-menu\">...</div>\n  </div>\n</div>"
        }
      ]
    },
    {
      "title": "With Separator",
      "examples": [
        {
          "items": [
            {
              "tag": "div",
              "class": "ui-dropdown-menu ui-dropdown-menu--open",
              "children": [
                {
                  "tag": "button",
                  "class": "ui-dropdown-menu__trigger ui-button ui-button--secondary",
                  "attrs": { "type": "button" },
                  "text": "File"
                },
                {
                  "tag": "div",
                  "class": "ui-dropdown-menu__panel",
                  "attrs": { "role": "menu" },
                  "children": [
                    {
                      "tag": "div",
                      "class": "ui-menu",
                      "children": [
                        {
                          "tag": "ul",
                          "class": "ui-menu__group",
                          "children": [
                            {
                              "tag": "li",
                              "children": [
                                {
                                  "tag": "button",
                                  "class": "ui-menu__item",
                                  "attrs": { "role": "menuitem" },
                                  "text": "New"
                                }
                              ]
                            },
                            {
                              "tag": "li",
                              "children": [
                                {
                                  "tag": "button",
                                  "class": "ui-menu__item",
                                  "attrs": { "role": "menuitem" },
                                  "text": "Open"
                                }
                              ]
                            },
                            {
                              "tag": "li",
                              "children": [
                                {
                                  "tag": "button",
                                  "class": "ui-menu__item",
                                  "attrs": { "role": "menuitem" },
                                  "text": "Save"
                                }
                              ]
                            },
                            {
                              "tag": "li",
                              "children": [{ "tag": "hr", "class": "ui-menu__separator" }]
                            },
                            {
                              "tag": "li",
                              "children": [
                                {
                                  "tag": "button",
                                  "class": "ui-menu__item ui-menu__item--danger",
                                  "attrs": { "role": "menuitem" },
                                  "text": "Close"
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "code": "<div class=\"ui-dropdown-menu ui-dropdown-menu--open\">\n  <button class=\"ui-dropdown-menu__trigger ui-button ui-button--secondary\">File</button>\n  <div class=\"ui-dropdown-menu__panel\" role=\"menu\">\n    <div class=\"ui-menu\">\n      <ul class=\"ui-menu__group\">\n        <li><button class=\"ui-menu__item\">New</button></li>\n        <li><hr class=\"ui-menu__separator\"></li>\n        <li><button class=\"ui-menu__item--danger\">Close</button></li>\n      </ul>\n    </div>\n  </div>\n</div>"
        }
      ]
    },
    {
      "title": "Top Position",
      "description": "Opens panel above the trigger.",
      "examples": [
        {
          "code": "<div class=\"ui-dropdown-menu ui-dropdown-menu--open ui-dropdown-menu--top\">\n  <button class=\"ui-dropdown-menu__trigger ui-button\">Actions</button>\n  <div class=\"ui-dropdown-menu__panel\" role=\"menu\">\n    <div class=\"ui-menu\">...</div>\n  </div>\n</div>"
        }
      ]
    },
    {
      "title": "Full Width",
      "description": "Panel stretches to match trigger width.",
      "examples": [
        {
          "code": "<div class=\"ui-dropdown-menu ui-dropdown-menu--open ui-dropdown-menu--full-width\">\n  <button class=\"ui-dropdown-menu__trigger ui-button\">Select option</button>\n  <div class=\"ui-dropdown-menu__panel\" role=\"menu\">\n    <div class=\"ui-menu\">...</div>\n  </div>\n</div>"
        }
      ]
    },
    {
      "title": "Align End",
      "examples": [
        {
          "items": [
            {
              "tag": "div",
              "style": { "display": "flex", "justify-content": "flex-end" },
              "children": [
                {
                  "tag": "div",
                  "class": "ui-dropdown-menu ui-dropdown-menu--open ui-dropdown-menu--align-end",
                  "children": [
                    {
                      "tag": "button",
                      "class": "ui-dropdown-menu__trigger ui-button ui-button--ghost",
                      "attrs": { "type": "button" },
                      "text": "\u22EE"
                    },
                    {
                      "tag": "div",
                      "class": "ui-dropdown-menu__panel",
                      "attrs": { "role": "menu" },
                      "children": [
                        {
                          "tag": "div",
                          "class": "ui-menu",
                          "children": [
                            {
                              "tag": "ul",
                              "class": "ui-menu__group",
                              "children": [
                                {
                                  "tag": "li",
                                  "children": [
                                    {
                                      "tag": "button",
                                      "class": "ui-menu__item",
                                      "attrs": { "role": "menuitem" },
                                      "text": "View"
                                    }
                                  ]
                                },
                                {
                                  "tag": "li",
                                  "children": [
                                    {
                                      "tag": "button",
                                      "class": "ui-menu__item",
                                      "attrs": { "role": "menuitem" },
                                      "text": "Share"
                                    }
                                  ]
                                },
                                {
                                  "tag": "li",
                                  "children": [
                                    {
                                      "tag": "button",
                                      "class": "ui-menu__item ui-menu__item--danger",
                                      "attrs": { "role": "menuitem" },
                                      "text": "Remove"
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ],
          "code": "<div class=\"ui-dropdown-menu ui-dropdown-menu--open ui-dropdown-menu--align-end\">\n  <button class=\"ui-dropdown-menu__trigger ui-button ui-button--ghost\">\u22EE</button>\n  <div class=\"ui-dropdown-menu__panel\" role=\"menu\">\n    <div class=\"ui-menu\">...</div>\n  </div>\n</div>"
        }
      ]
    }
  ],
  "customization": [
    {
      "token": "--ui-dropdown-menu-z",
      "default": "200",
      "description": "Z-index for floating panel"
    },
    {
      "token": "--ui-dropdown-menu-panel-offset",
      "default": "var(--ui-space-1)",
      "description": "Gap between trigger and panel"
    },
    {
      "token": "--ui-dropdown-menu-panel-min-width",
      "default": "auto",
      "description": "Minimum panel width"
    }
  ]
}
