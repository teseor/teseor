{
  "api": "./pagination.api.json",
  "sections": [
    {
      "title": "Default",
      "examples": [
        {
          "items": [
            {
              "tag": "nav",
              "class": "ui-pagination",
              "children": [
                {
                  "tag": "a",
                  "class": "ui-pagination__link ui-pagination__prev",
                  "attrs": { "href": "#" },
                  "text": "Prev"
                },
                {
                  "tag": "ul",
                  "class": "ui-pagination__list",
                  "children": [
                    {
                      "tag": "li",
                      "class": "ui-pagination__item",
                      "children": [
                        {
                          "tag": "a",
                          "class": "ui-pagination__link",
                          "attrs": { "href": "#" },
                          "text": "1"
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "class": "ui-pagination__item",
                      "children": [
                        {
                          "tag": "a",
                          "class": "ui-pagination__link ui-pagination__link--active",
                          "attrs": { "aria-current": "page", "href": "#" },
                          "text": "2"
                        }
                      ]
                    },
                    {
                      "tag": "li",
                      "class": "ui-pagination__item",
                      "children": [
                        {
                          "tag": "a",
                          "class": "ui-pagination__link",
                          "attrs": { "href": "#" },
                          "text": "3"
