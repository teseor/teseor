{
  "id": "status",
  "type": "component",
  "title": "Status",
  "description": "Visual status indicator with colored dot to show state.",
  "api": "./status.api.json",
  "sections": [
    {
      "title": "Variants",
      "examples": [
        {
          "items": [
            {
              "tag": "div",
              "attrs": {
                "style": "display: flex; flex-direction: column; gap: var(--ui-space-2);"
              },
              "children": [
                {
                  "tag": "span",
                  "class": "ui-status",
                  "children": [{ "tag": "span", "class": "ui-status__dot" }, { "text": "Default" }]
                },
                {
                  "tag": "span",
                  "class": "ui-status ui-status--success",
                  "children": [{ "tag": "span", "class": "ui-status__dot" }, { "text": "Online" }]
                },
                {
                  "tag": "span",
                  "class": "ui-status ui-status--warning",
                  "children": [{ "tag": "span", "class": "ui-status__dot" }, { "text": "Away" }]
                },
                {
                  "tag": "span",
                  "class": "ui-status ui-status--danger",
                  "children": [{ "tag": "span", "class": "ui-status__dot" }, { "text": "Busy" }]
                },
                {
                  "tag": "span",
                  "class": "ui-status ui-status--info",
                  "children": [
                    { "tag": "span", "class": "ui-status__dot" },
                    { "text": "In a meeting" }
                  ]
                }
              ]
            }
          ],
          "code": "<span class=\"ui-status ui-status--success\">\n  <span class=\"ui-status__dot\"></span>\n  Online\n</span>"
        }
      ]
    },
    {
      "title": "Sizes",
      "examples": [
        {
          "items": [
            {
              "tag": "div",
              "attrs": { "style": "display: flex; gap: var(--ui-space-4); align-items: center;" },
              "children": [
                {
                  "tag": "span",
                  "class": "ui-status ui-status--success ui-status--sm",
                  "children": [{ "tag": "span", "class": "ui-status__dot" }, { "text": "Small" }]
                },
                {
                  "tag": "span",
                  "class": "ui-status ui-status--success",
                  "children": [{ "tag": "span", "class": "ui-status__dot" }, { "text": "Default" }]
                },
                {
                  "tag": "span",
                  "class": "ui-status ui-status--success ui-status--lg",
                  "children": [{ "tag": "span", "class": "ui-status__dot" }, { "text": "Large" }]
                }
              ]
            }
          ],
          "code": "<span class=\"ui-status ui-status--sm\">...</span>\n<span class=\"ui-status\">...</span>\n<span class=\"ui-status ui-status--lg\">...</span>"
        }
      ]
    },
    {
      "title": "Pulse Animation",
      "description": "For live or active indicators",
      "api": "./status.api.json",
      "examples": [
        {
          "items": [
            {
              "tag": "span",
              "class": "ui-status ui-status--success ui-status--pulse",
              "children": [{ "tag": "span", "class": "ui-status__dot" }, { "text": "Live" }]
            }
          ],
          "code": "<span class=\"ui-status ui-status--success ui-status--pulse\">\n  <span class=\"ui-status__dot\"></span>\n  Live\n</span>"
        }
      ]
    },
    {
      "title": "Dot Only",
      "examples": [
        {
          "items": [
            {
              "tag": "div",
              "attrs": { "style": "display: flex; gap: var(--ui-space-2);" },
              "children": [
                {
                  "tag": "span",
                  "class": "ui-status ui-status--success",
                  "children": [{ "tag": "span", "class": "ui-status__dot" }]
                },
                {
                  "tag": "span",
                  "class": "ui-status ui-status--warning",
                  "children": [{ "tag": "span", "class": "ui-status__dot" }]
                },
                {
                  "tag": "span",
                  "class": "ui-status ui-status--danger",
                  "children": [{ "tag": "span", "class": "ui-status__dot" }]
                }
              ]
            }
          ],
          "code": "<span class=\"ui-status ui-status--success\">\n  <span class=\"ui-status__dot\"></span>\n</span>"
        }
      ]
    }
  ],
  "customization": [
    { "token": "--ui-status-size", "default": "var(--ui-unit)", "description": "Dot size" },
    {
      "token": "--ui-status-color",
      "default": "var(--ui-color-text-muted)",
      "description": "Default dot color"
    },
    {
      "token": "--ui-status-gap",
      "default": "var(--ui-unit)",
      "description": "Gap between dot and text"
    }
  ]
}
