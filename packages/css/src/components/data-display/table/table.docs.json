{
  "id": "table",
  "type": "component",
  "title": "Table",
  "description": "Styled table with header formatting and optional variants.",
  "api": "./table.api.json",
  "componentName": "table",
  "sections": [
    {
      "title": "Basic table",
      "examples": [
        {
          "title": "Default",
          "items": [
            {
              "tag": "table",
              "class": "ui-table",
              "children": [
                {
                  "tag": "thead",
                  "children": [
                    {
                      "tag": "tr",
                      "children": [
                        { "tag": "th", "text": "Name" },
                        { "tag": "th", "text": "Value" }
                      ]
                    }
                  ]
                },
                {
                  "tag": "tbody",
                  "children": [
                    {
                      "tag": "tr",
                      "children": [{ "tag": "td", "text": "Alpha" }, { "tag": "td", "text": "100" }]
                    },
                    {
                      "tag": "tr",
                      "children": [{ "tag": "td", "text": "Beta" }, { "tag": "td", "text": "200" }]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "title": "Variants",
      "examples": [
        {
          "title": "Compact",
          "items": [
            {
              "tag": "table",
              "class": "ui-table ui-table--compact",
              "children": [
                {
                  "tag": "thead",
                  "children": [
                    {
                      "tag": "tr",
                      "children": [
                        { "tag": "th", "text": "Token" },
                        { "tag": "th", "text": "Value" }
                      ]
                    }
                  ]
                },
                {
                  "tag": "tbody",
                  "children": [
                    {
                      "tag": "tr",
                      "children": [
                        {
                          "tag": "td",
                          "children": [
                            { "tag": "code", "class": "ui-code ui-code--sm", "text": "--space-1" }
                          ]
                        },
                        { "tag": "td", "text": "0.5rem" }
                      ]
                    },
                    {
                      "tag": "tr",
                      "children": [
                        {
                          "tag": "td",
                          "children": [
                            { "tag": "code", "class": "ui-code ui-code--sm", "text": "--space-2" }
                          ]
                        },
                        { "tag": "td", "text": "1rem" }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Striped",
          "items": [
            {
              "tag": "table",
              "class": "ui-table ui-table--striped",
              "children": [
                {
                  "tag": "thead",
                  "children": [
                    {
                      "tag": "tr",
                      "children": [
                        { "tag": "th", "text": "Item" },
                        { "tag": "th", "text": "Status" }
                      ]
                    }
                  ]
                },
                {
                  "tag": "tbody",
                  "children": [
                    {
                      "tag": "tr",
                      "children": [
                        { "tag": "td", "text": "Task 1" },
                        { "tag": "td", "text": "Done" }
                      ]
                    },
                    {
                      "tag": "tr",
                      "children": [
                        { "tag": "td", "text": "Task 2" },
                        { "tag": "td", "text": "Pending" }
                      ]
                    },
                    {
                      "tag": "tr",
                      "children": [
                        { "tag": "td", "text": "Task 3" },
                        { "tag": "td", "text": "Done" }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "customization": [
    {
      "token": "--ui-table-font-size",
      "default": "var(--ui-font-size-sm)",
      "description": "Table font size"
    },
    {
      "token": "--ui-table-border-color",
      "default": "var(--ui-color-border)",
      "description": "Border color"
    },
    {
      "token": "--ui-table-header-bg",
      "default": "var(--ui-color-bg-subtle)",
      "description": "Header background"
    },
    {
      "token": "--ui-table-cell-padding-x",
      "default": "var(--ui-space-2)",
      "description": "Cell horizontal padding"
    },
    {
      "token": "--ui-table-cell-padding-y",
      "default": "var(--ui-space-1)",
      "description": "Cell vertical padding"
    }
  ]
}
