{
  "name": "@teseor/react",
  "version": "3.0.0",
  "private": true,
  "description": "React wrappers for Teseor components.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./_runtime.test": null,
    "./*": "./src/*"
  },
  "files": [
    "src",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teseor/teseor.git",
    "directory": "packages/react"
  },
  "dependencies": {
    "@teseor/css": "workspace:*",
    "@teseor/primitives": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@teseor/test-internals": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  }
}
