{
  "name": "@teseor/vue",
  "version": "3.0.0",
  "private": true,
  "description": "Vue wrappers for Teseor components.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./_dom-polyfills": null,
    "./_runtime.test": null,
    "./*": "./src/*"
  },
  "files": [
    "src",
    "!src/**/*.test.*",
    "!src/_dom-polyfills.ts"
  ],
  "scripts": {
    "typecheck": "vue-tsc --noEmit"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teseor/teseor.git",
    "directory": "packages/vue"
  },
  "dependencies": {
    "@teseor/css": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.5"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.10",
    "vue": "^3.5.34",
    "vue-tsc": "^3.3.1"
  }
}
