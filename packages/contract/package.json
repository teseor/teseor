{
  "name": "@teseor/contract",
  "version": "0.1.0",
  "description": "TypeScript contract for CSS components — types and class builders",
  "license": "MIT",
  "author": "letanure",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "generate": "tsx ../../scripts/generate-contract.ts"
  },
  "devDependencies": {
    "tsup": "^8.4.0"
  }
}
