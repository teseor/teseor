# Warn if no changeset exists for feature/fix branches
branch=$(git branch --show-current)
if echo "$branch" | grep -qE '^(feat|fix)/'; then
  if [ -z "$(git diff main --name-only -- .changeset/*.md 2>/dev/null)" ]; then
    echo ""
    echo "WARNING: No changeset found on $branch"
    echo "Run: pnpm changeset"
    echo ""
  fi
fi

