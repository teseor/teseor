# Skip all checks with SKIP_PUSH_HOOKS=1 git push
if [ "${SKIP_PUSH_HOOKS-}" = "1" ]; then
  echo "pre-push: skipping checks (SKIP_PUSH_HOOKS=1)"
  exit 0
fi

# Warn if branch is behind main (bypass with SKIP_PUSH_HOOKS=1)
branch=$(git branch --show-current)
if [ "$branch" != "main" ] && [ "$branch" != "changeset-release/main" ]; then
  git fetch origin main --quiet 2>/dev/null || true
  behind=$(git rev-list --count HEAD..origin/main 2>/dev/null || echo "0")
  if [ "$behind" -gt 0 ]; then
    echo ""
    echo "WARNING: Branch is $behind commit(s) behind main. Rebase first:"
    echo "  git fetch origin main && git rebase origin/main"
    echo ""
    exit 1
  fi
fi

pnpm lint
pnpm typecheck
pnpm nx build css

# Warn if no changeset exists for feature/fix branches
if echo "$branch" | grep -qE '^(feat|fix)/'; then
  if [ -z "$(git diff main --name-only -- .changeset/*.md 2>/dev/null)" ]; then
    echo ""
    echo "WARNING: No changeset found on $branch"
    echo "Run: pnpm changeset"
    echo ""
  fi
fi

